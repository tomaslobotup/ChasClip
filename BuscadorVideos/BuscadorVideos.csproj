<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>ChasClip</AssemblyName>
    <RootNamespace>BuscadorVideos</RootNamespace>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <Version>1.3.0</Version>
    <Product>ChasClip</Product>
    <Authors>tomaslobotup</Authors>
    <Description>ChasClip — Buscador Multisitio Universal y Descargador de Videos</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="SkiaSharp" Version="4.154.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\icon.png" />
    <Resource Include="Assets\logo.ico" />
  </ItemGroup>

</Project>
