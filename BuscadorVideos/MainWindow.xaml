                                                            <TextBlock Text="🌙" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                            <TextBlock Text="Oscuro" Foreground="#F1F5F9" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
