                                                                Padding="8,4"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Click="RecentDownloadOpenFolder_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
