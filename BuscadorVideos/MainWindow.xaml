<Window x:Class="BuscadorVideos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:BuscadorVideos.Controls"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="ChasClip — Descargador Universal Multimedia"
        Icon="pack://application:,,,/Assets/logo.ico"
        Width="1380"
        Height="880"
        MinWidth="980"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">

    <Grid ClipToBounds="True">
        <!-- WebView2 fuera de pantalla (-3000,-3000) con resolución 1280x800: nunca se superpone a la ventana -->
        <Border Width="1280"
                Height="800"
                Margin="-3000,-3000,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                IsHitTestVisible="False">
            <wv2:WebView2 x:Name="ScraperWebView" Width="1280" Height="800"/>
        </Border>

        <!-- ==================== LAYOUT PRINCIPAL ==================== -->
        <Grid x:Name="MainLayoutGrid"
              Panel.ZIndex="10"
              Background="{DynamicResource AppBackgroundBrush}"
              Opacity="0"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="MainLayoutTranslate" Y="14"/>
            </Grid.RenderTransform>

            <!-- ==================== 1) MENÚ INICIAL / PANTALLA DE BIENVENIDA ==================== -->
            <Grid x:Name="HomeMenuGrid" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Barra Superior del Menú Inicial -->
                <Border Grid.Row="0"
                        Background="{DynamicResource AppHeaderBackgroundBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="28,14">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/Assets/icon.png"
                                   Height="34"
                                   Stretch="Uniform"
                                   Margin="0,0,10,0"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            <Image Source="pack://application:,,,/Assets/logo.png"
                                   MaxHeight="30"
                                   Stretch="Uniform"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            <Border Margin="14,0,0,0"
                                    Background="{DynamicResource AppSubtleBrush}"
                                    BorderBrush="{DynamicResource AppAccentBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,3"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Descargador Universal Multimedia"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="📥 Cola de Descargas"
                                    Margin="0,0,8,0"
                                    Padding="12,7"
                                    ToolTip="Ver lista de espera e historial de descargas"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="ToggleDownloadQueueDrawer_Click"/>
                            <Button Content="⚙ Ajustes"
                                    Margin="0,0,8,0"
                                    Padding="12,7"
                                    ToolTip="Abrir apartado de Ajustes"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OpenSettingsModalButton_Click"/>
                            <Button Content="☕ Invitar un Cafecito"
                                    Padding="12,7"
                                    ToolTip="Regálame un cafecito para seguir mejorándolo (cafecito.app/atomichead)"
                                    Style="{StaticResource CafecitoButtonStyle}"
                                    Click="DonateCafecitoButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Contenido Central: Título y las 2 Opciones Principales + Botón BETA -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="20,28">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="960">

                        <TextBlock Text="Descargador Universal Multimedia"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="Descarga videos y música de cualquier plataforma mediante enlace directo o explora la red con el buscador web y tus atajos favoritos."
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   FontSize="13.5"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,0,0,22"/>

                        <!-- Barra de Reanudar Sesión / Volver a la Búsqueda o Buscador Web -->
                        <Border x:Name="HomeResumeSessionBorder"
                                Background="{DynamicResource AppSurfaceBrush}"
                                BorderBrush="{DynamicResource AppAccentBorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="12"
                                Padding="16,11"
                                Margin="0,0,0,18"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="34" Height="34"
                                        CornerRadius="9"
                                        Background="{DynamicResource AppSubtleBrush}"
                                        BorderBrush="{DynamicResource AppAccentBorderBrush}"
                                        BorderThickness="1"
                                        Margin="0,0,13,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="▶" Foreground="{DynamicResource AppAccentTextBrush}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="HomeResumeSessionTitleText"
                                               Text="SESIÓN ACTIVA"
                                               Foreground="{DynamicResource AppAccentTextBrush}"
                                               FontSize="10.5"
                                               FontWeight="Bold"/>
                                    <TextBlock x:Name="HomeResumeSessionDescText"
                                               Text="Tienes una página abierta en el Buscador Web"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                                               FontSize="13"
                                               FontWeight="SemiBold"/>
                                </StackPanel>

                                <Button x:Name="HomeResumeSessionBtn"
                                        Grid.Column="2"
                                        Content="↩ Reanudar Buscador Web"
                                        Padding="16,8"
                                        FontSize="12.5"
                                        FontWeight="Bold"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="HomeResumeSessionBtn_Click"/>

                                <Button Grid.Column="3"
                                        Content="✕"
                                        Margin="8,0,0,0"
                                        Width="28"
                                        Height="28"
                                        FontSize="11"
                                        ToolTip="Descartar"
                                        Style="{StaticResource IconButtonStyle}"
                                        Click="HomeDismissResumeSession_Click"/>
                            </Grid>
                        </Border>

                        <!-- Contenedor de las 2 Opciones Principales en Paralelo -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Opción 1: Descargador Directo por Enlace -->
                            <Border Grid.Column="0"
                                    Background="{DynamicResource AppSurfaceBrush}"
                                    BorderBrush="{DynamicResource AppCardBorderBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="16"
                                    Padding="28,26"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="HomeMenu_OpenDownloader_Click">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Color="#0E0E0F" Opacity="0.4"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                                        <Border Width="50" Height="50" CornerRadius="12" Background="{DynamicResource AppSubtleBrush}" BorderBrush="{DynamicResource AppAccentBorderBrush}" BorderThickness="1">
                                            <TextBlock Text="📥" FontSize="24" Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="DESCARGA DIRECTA" Foreground="{DynamicResource AppAccentTextBrush}" FontSize="11" FontWeight="Bold"/>
                                            <TextBlock Text="Por Enlace o URL" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="15" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1"
                                               Text="Descargador por Enlace"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                                               FontSize="18.5"
                                               FontWeight="Bold"
                                               Margin="0,0,0,10"/>

                                    <TextBlock Grid.Row="2"
                                               Text="Pega cualquier enlace directo https://... de YouTube, TikTok, Instagram, Twitch, Dailymotion o videos web. Descarga en máxima calidad (1080p, 720p...) o extrae únicamente la pista de audio en formato MP3."
                                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                                               FontSize="13"
                                               LineHeight="20"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,24"/>

                                    <Button Grid.Row="3"
                                            Content="📥 Abrir Descargador Directo →"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Padding="16,11"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="HomeMenu_OpenDownloader_Click"/>
                                </Grid>
                            </Border>

                            <!-- Opción 2: Buscador Web -->
                            <Border Grid.Column="2"
                                    Background="{DynamicResource AppSurfaceBrush}"
                                    BorderBrush="{DynamicResource AppCardBorderBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="16"
                                    Padding="28,26"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="HomeMenu_OpenBrowser_Click">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Color="#0E0E0F" Opacity="0.4"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                                        <Border Width="50" Height="50" CornerRadius="12" Background="{DynamicResource AppSubtleBrush}" BorderBrush="{DynamicResource AppAccentBorderBrush}" BorderThickness="1">
                                            <TextBlock Text="🌐" FontSize="24" Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="NAVEGACIÓN DIRECTA" Foreground="{DynamicResource AppAccentTextBrush}" FontSize="11" FontWeight="Bold"/>
                                            <TextBlock Text="Buscador Web" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="15" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1"
                                               Text="Buscador Web"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                                               FontSize="18.5"
                                               FontWeight="Bold"
                                               Margin="0,0,0,10"/>

                                    <TextBlock Grid.Row="2"
                                               Text="Navega por cualquier sitio web, pon atajos de tus páginas preferidas y descarga los videos que encuentres directamente a la lista de espera."
                                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                                               FontSize="13"
                                               LineHeight="20"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,24"/>

                                    <Button Grid.Row="3"
                                            Content="🌐 Abrir Buscador Web →"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Padding="16,11"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="HomeMenu_OpenBrowser_Click"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Opción 3: Botón BETA para Funciones Experimentales -->
                        <Border Background="{DynamicResource AppSurfaceBrush}"
                                BorderBrush="{DynamicResource AppAccentBorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="14"
                                Padding="22,16"
                                Margin="0,0,0,22"
                                Cursor="Hand"
                                MouseLeftButtonUp="HomeMenu_OpenSearch_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="{DynamicResource AppAccentBrush}"
                                        BorderBrush="{DynamicResource AppAccentBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,5"
                                        VerticalAlignment="Center"
                                        Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🧪" FontSize="14" Margin="0,0,5,0"/>
                                        <TextBlock Text="BETA"
                                                   Foreground="{DynamicResource AppAccentForegroundBrush}"
                                                   FontSize="12"
                                                   FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Funciones Experimentales (BETA)"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                                               FontSize="15"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="Características y herramientas experimentales en fase de prueba."
                                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                                               FontSize="12.5"
                                               Margin="0,3,0,0"/>
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Content="⚡ Abrir BETA →"
                                        Padding="16,8"
                                        FontSize="12.5"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="HomeMenu_OpenSearch_Click"/>
                            </Grid>
                        </Border>

                        <!-- Indicación de plataformas compatibles -->
                        <Border Background="{DynamicResource AppSurfaceBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16,11"
                                HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Plataformas principales compatibles:"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <Border Background="{DynamicResource AppSubtleBrush}" BorderBrush="{DynamicResource AppAccentBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="3,0">
                                    <TextBlock Text="YouTube" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="{DynamicResource AppSubtleBrush}" BorderBrush="{DynamicResource AppAccentBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="3,0">
                                    <TextBlock Text="Twitch" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="{DynamicResource AppSubtleBrush}" BorderBrush="{DynamicResource AppAccentBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="3,0">
                                    <TextBlock Text="TikTok" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="{DynamicResource AppSubtleBrush}" BorderBrush="{DynamicResource AppAccentBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="3,0">
                                    <TextBlock Text="Instagram" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="{DynamicResource AppSubtleBrush}" BorderBrush="{DynamicResource AppAccentBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="3,0">
                                    <TextBlock Text="Dailymotion" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Pie del Menú Inicial -->
                <Border Grid.Row="2"
                        Background="{DynamicResource AppHeaderBackgroundBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="24,9">
                    <Grid>
                        <TextBlock Text="ChasClip • Descargador Universal Multimedia"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   FontSize="11.5"
                                   VerticalAlignment="Center"/>
                        <TextBlock HorizontalAlignment="Right"
                                   Text="v1.3.0"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   FontSize="11.5"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================== 2) ÁREA DEL BUSCADOR UNIVERSAL ==================== -->
            <Grid x:Name="SearchAreaGrid" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="340"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ==================== PANEL LATERAL COLAPSABLE ==================== -->
                <Border x:Name="SidebarBorder"
                        Grid.Column="0"
                        Background="{DynamicResource AppSidebarBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="0,0,1,0"
                        ClipToBounds="True">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="SidebarTranslate" X="0"/>
                    </Border.RenderTransform>

                <Grid Margin="15,13,15,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Cabecera: Texto e Ícono 8-bit oficial ChasClip + Botón ocultar panel -->
                    <Border Grid.Row="0"
                            Margin="0,0,0,11"
                            Padding="4,2,2,11"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,0,0">
                                <Image Source="pack://application:,,,/Assets/icon.png"
                                       Height="34"
                                       Stretch="Uniform"
                                       Margin="0,0,8,0"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                <Image Source="pack://application:,,,/Assets/logo.png"
                                       MaxHeight="30"
                                       Stretch="Uniform"
                                       VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="◀"
                                    Width="30"
                                    Height="30"
                                    FontSize="12"
                                    VerticalAlignment="Center"
                                    ToolTip="Ocultar panel lateral (Ctrl+B)"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="0"
                                    Click="ToggleSidebarButton_Click"/>
                        </Grid>
                    </Border>

                    <!-- Accesos Rápidos (Favoritos e Historial) y Selector de Páginas -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,11">
                        <!-- Accesos Rápidos: Favoritos e Historial en la Barra Lateral -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="SidebarFavoritesButton"
                                    Grid.Column="0"
                                    Content="⭐ Favoritos"
                                    FontSize="12"
                                    Padding="6,7"
                                    ToolTip="Ver tus videos guardados como favoritos"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OpenFavoritesView_Click"/>

                            <Button x:Name="SidebarHistoryButton"
                                    Grid.Column="2"
                                    Content="🕒 Historial"
                                    FontSize="12"
                                    Padding="6,7"
                                    ToolTip="Ver historial de videos reproducidos recientemente"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OpenHistoryView_Click"/>
                        </Grid>

                        <!-- Selector entre Mis Páginas y Páginas NSFW (+18) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="ShowCustomSitesButton"
                                    Grid.Column="0"
                                    Margin="0,0,4,0"
                                    Content="▶ Mis Páginas"
                                    FontSize="12"
                                    Padding="8,7"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="ShowCustomSitesButton_Click"/>

                            <Button x:Name="ToggleNsfwPanelButton"
                                    Grid.Column="1"
                                    Margin="4,0,0,0"
                                    Content="🔞 Páginas NSFW"
                                    FontSize="12"
                                    Padding="8,7"
                                    Visibility="Collapsed"
                                    ToolTip="Toca para ver portales NSFW directos (brilla); vuelve a tocar para desmarcar y apagar NSFW"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="ToggleNsfwPanelButton_Click"/>
                        </Grid>
                    </StackPanel>

                    <!-- Formulario Agregar Página -->
                    <StackPanel x:Name="CustomSiteFormPanel" Grid.Row="2" Margin="0,0,0,10">
                        <TextBlock Text="Nombre del buscador / página:"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   FontSize="11.5"
                                   Margin="0,0,0,3"/>
                        <TextBox x:Name="NewSiteNameTextBox"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 FontSize="12.5"
                                 Padding="10,6"
                                 Margin="0,0,0,7"
                                 ToolTip="Ej: YouTube, Dailymotion, Vimeo..."
                                 KeyDown="NewSiteInput_KeyDown"/>

                        <TextBlock Text="Enlace (URL, dominio o plantilla {q}):"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   FontSize="11.5"
                                   Margin="0,0,0,3"/>
                        <TextBox x:Name="NewSiteUrlTextBox"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 FontSize="12.5"
                                 Padding="10,6"
                                 Margin="0,0,0,8"
                                 ToolTip="Ej: https://www.youtube.com, dailymotion.com, https://sitio.com/search?q={q}"
                                 KeyDown="NewSiteInput_KeyDown"/>

                        <Button Content="＋ Agregar a mi lista"
                                Padding="12,7"
                                FontSize="12.5"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="AddSiteButton_Click"/>
                    </StackPanel>

                    <!-- Acciones rápidas de Mi Lista + Revertir lo borrado + Restaurar predeterminadas -->
                    <StackPanel x:Name="CustomSiteActionsPanel" Grid.Row="3" Margin="0,0,0,8">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Margin="0,0,3,0"
                                    Content="Marcar todas"
                                    FontSize="11.5"
                                    Padding="7,5"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="SelectAllSites_Click"/>
                            <Button Grid.Column="1"
                                    Margin="3,0,3,0"
                                    Content="Desmarcar"
                                    FontSize="11.5"
                                    Padding="7,5"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="DeselectAllSites_Click"/>
                            <Button Grid.Column="2"
                                    Margin="3,0,0,0"
                                    Content="↺ Base"
                                    FontSize="11.5"
                                    Padding="8,5"
                                    ToolTip="Restaurar buscadores de video predeterminados que falten en la lista"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="RestoreDefaultSites_Click"/>
                        </Grid>

                        <Button x:Name="UndoDeletedSiteButton"
                                Content="↶ Revertir borrado en mi lista"
                                FontSize="11.5"
                                Padding="8,5"
                                IsEnabled="False"
                                ToolTip="Restaura la última página eliminada de tu lista"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="UndoDeletedSiteButton_Click"/>
                    </StackPanel>

                    <!-- Lista de páginas guardadas -->
                    <ScrollViewer x:Name="CustomSitesScrollViewer"
                                  Grid.Row="4"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="SavedSitesItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6"
                                            Padding="9,7"
                                            CornerRadius="9"
                                            Background="{DynamicResource AppCardBackgroundBrush}"
                                            BorderBrush="{DynamicResource AppCardBorderBrush}"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0"
                                                      Click="SiteCheckBox_Click"/>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource AppAccentBorderBrush}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                               FontSize="12.5"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Url}"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                           FontSize="10.5"
                                                           Margin="14,1,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <Button Grid.Column="2"
                                                    Content="✎"
                                                    ToolTip="Editar nombre y enlace"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    Tag="{Binding}"
                                                    Click="EditSiteButton_Click"/>

                                            <Button Grid.Column="3"
                                                    Content="✕"
                                                    ToolTip="Eliminar de mi lista (puedes revertirlo arriba)"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    Tag="{Binding}"
                                                    Click="DeleteSiteButton_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Panel desplegable de Colecciones NSFW verificadas (solo portales directos, sin Hentai) -->
                    <Grid x:Name="NsfwPanelGrid" Grid.Row="4" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="NsfwCategoriesItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,7"
                                                CornerRadius="9"
                                                Background="{DynamicResource AppCardBackgroundBrush}"
                                                BorderBrush="{DynamicResource AppCardBorderBrush}"
                                                BorderThickness="1">
                                            <StackPanel>
                                                <Grid Margin="10,7">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding IsCategoryChecked, Mode=TwoWay}"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,8,0"
                                                              ToolTip="Marcar o desmarcar todas las páginas de esta categoría"
                                                              Click="NsfwCategoryCheckBox_Click"/>

                                                    <ToggleButton Grid.Column="1"
                                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                                  Cursor="Hand"
                                                                  Background="Transparent"
                                                                  BorderThickness="0"
                                                                  HorizontalContentAlignment="Stretch">
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Grid Background="Transparent">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0"
                                                                               Text="{Binding HeaderSummary}"
                                                                               ToolTip="{Binding HeaderSummary}"
                                                                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                                               FontSize="12.5"
                                                                               FontWeight="SemiBold"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock x:Name="chevronTxt"
                                                                               Grid.Column="1"
                                                                               Text="▸"
                                                                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                                               FontSize="13"
                                                                               Margin="6,0,2,0"
                                                                               VerticalAlignment="Center"/>
                                                                </Grid>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter TargetName="chevronTxt" Property="Text" Value="▾"/>
                                                                        <Setter TargetName="chevronTxt" Property="Foreground" Value="{DynamicResource AppAccentTextBrush}"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="chevronTxt" Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                    </ToggleButton>
                                                </Grid>

                                                <Border BorderBrush="{DynamicResource AppBorderBrush}"
                                                        BorderThickness="0,1,0,0"
                                                        Background="{DynamicResource AppSubtleBrush}"
                                                        CornerRadius="0,0,8,8"
                                                        Padding="10,6,8,6">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <ItemsControl ItemsSource="{Binding Sites}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,3">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <CheckBox Grid.Column="0"
                                                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                              VerticalAlignment="Center"
                                                                              Margin="4,0,8,0"
                                                                              Click="NsfwSiteCheckBox_Click"/>

                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding DisplayName}"
                                                                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                                                   FontSize="12"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Text="{Binding Domain}"
                                                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                                                   FontSize="10.5"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Estado de autoguardado -->
                    <Border Grid.Row="5"
                            Margin="0,7,0,0"
                            Padding="10,7"
                            CornerRadius="8"
                            Background="{DynamicResource AppSubtleBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1">
                        <TextBlock x:Name="SaveStatusTextBlock"
                                   Text="✓ Lista guardada automáticamente"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ==================== ÁREA PRINCIPAL: BUSCADOR CON HISTORIAL, CONTROLES, CUADRÍCULA 3x4 Y PAGINACIÓN ==================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Barra Superior de Búsqueda, Historial Desplegable, Revertir, Borrar y Bloqueador de Anuncios -->
                <Border Grid.Row="0"
                        Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,13">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Navegación: Logo 8-bit ChasClip, Ocultar panel lateral, Ir a Menú Inicial, Ir a Descargas -->
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0">
                            <Button x:Name="TopToggleSidebarButton"
                                    Content="☰"
                                    FontSize="15"
                                    Padding="10,7"
                                    ToolTip="Ocultar o mostrar el panel lateral de páginas (Ctrl+B)"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="ToggleSidebarButton_Click"/>

                            <Border Background="{DynamicResource AppSubtleBrush}"
                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8,5"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="pack://application:,,,/Assets/icon.png"
                                           Width="20"
                                           Height="20"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           Margin="0,0,6,0"/>
                                    <Image Source="pack://application:,,,/Assets/logo.png"
                                           Height="16"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Button Content="🏠 Menú"
                                    Margin="6,0,0,0"
                                    Padding="9,7"
                                    FontSize="12"
                                    ToolTip="Volver al menú inicial de opciones"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="NavToHomeMenu_Click"/>

                            <Button Content="🌐 Buscador Web"
                                    Margin="6,0,0,0"
                                    Padding="9,7"
                                    FontSize="12"
                                    ToolTip="Abrir el buscador web"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="NavToBrowserArea_Click"/>

                            <Button Content="📥 Descargas"
                                    Margin="6,0,0,0"
                                    Padding="9,7"
                                    FontSize="12"
                                    ToolTip="Abrir descargador directo por enlace"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="NavToDownloaderArea_Click"/>

                            <Button Content="📋 Cola"
                                    Margin="6,0,0,0"
                                    Padding="9,7"
                                    FontSize="12"
                                    ToolTip="Ver cola e historial de descargas"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="ToggleDownloadQueueDrawer_Click"/>
                        </StackPanel>

                        <!-- Caja de Búsqueda con Historial Desplegable Integrado -->
                        <Grid x:Name="SearchInputContainer" Grid.Column="1">
                            <TextBox x:Name="SearchQueryTextBox"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     FontSize="14"
                                     Padding="13,9,72,9"
                                     PreviewMouseLeftButtonUp="SearchQueryTextBox_PreviewMouseLeftButtonUp"
                                     KeyDown="SearchQueryTextBox_KeyDown"
                                     TextChanged="SearchQueryTextBox_TextChanged"/>

                            <TextBlock Text="Buscar en ChasClip o pegar enlace https://..."
                                       Foreground="{DynamicResource AppTextMutedBrush}"
                                       FontSize="13.5"
                                       Margin="15,0,76,0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchQueryTextBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Botones internos dentro de la barra de búsqueda: Limpiar texto (✕) y Desplegar Historial (🕒) -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,6,0">
                                <Button x:Name="ClearQueryTextButton"
                                        Content="✕"
                                        Width="26"
                                        Height="26"
                                        FontSize="11.5"
                                        Visibility="Collapsed"
                                        ToolTip="Limpiar texto escrito"
                                        Style="{StaticResource IconButtonStyle}"
                                        Click="ClearQueryTextButton_Click"/>

                                <Button x:Name="ToggleHistoryDropdownButton"
                                        Content="🕒▾"
                                        Width="36"
                                        Height="26"
                                        FontSize="11.5"
                                        ToolTip="Desplegar historial de búsquedas"
                                        Style="{StaticResource IconButtonStyle}"
                                        Click="ToggleHistoryDropdownButton_Click"/>
                            </StackPanel>

                            <!-- Popup de Historial Desplegable Justo Debajo de la Búsqueda -->
                            <Popup x:Name="SearchHistoryPopup"
                                   PlacementTarget="{Binding ElementName=SearchInputContainer}"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Slide">
                                <Border Width="{Binding ActualWidth, ElementName=SearchInputContainer}"
                                        Margin="0,4,0,0"
                                        Background="{DynamicResource AppSurfaceBrush}"
                                        BorderBrush="{DynamicResource AppCardBorderBrush}"
                                        BorderThickness="1.5"
                                        CornerRadius="10"
                                        Padding="8">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="22" ShadowDepth="6" Color="#0E0E0F" Opacity="0.6"/>
                                    </Border.Effect>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="6,2,4,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="🕒 Historial de búsquedas recientes"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <Button x:Name="ClearAllHistoryButton"
                                                    Grid.Column="1"
                                                    Content="🗑️ Borrar todo"
                                                    FontSize="11"
                                                    Padding="8,3"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="ClearAllHistoryButton_Click"/>
                                        </Grid>

                                        <TextBlock x:Name="EmptyHistoryText"
                                                   Grid.Row="1"
                                                   Text="Aún no hay búsquedas guardadas en el historial."
                                                   Foreground="{DynamicResource AppTextMutedBrush}"
                                                   FontSize="12"
                                                   Margin="8,8,8,10"
                                                   Visibility="Collapsed"/>

                                        <ScrollViewer Grid.Row="2"
                                                      MaxHeight="250"
                                                      VerticalScrollBarVisibility="Auto">
                                            <ItemsControl x:Name="SearchHistoryItemsControl">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,1"
                                                                CornerRadius="7"
                                                                Background="Transparent">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <Button Grid.Column="0"
                                                                        Tag="{Binding}"
                                                                        Cursor="Hand"
                                                                        HorizontalContentAlignment="Stretch"
                                                                        Click="HistoryItemButton_Click">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="hBd"
                                                                                    Background="Transparent"
                                                                                    CornerRadius="7"
                                                                                    Padding="8,6">
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock Grid.Column="0"
                                                                                               Text="{Binding Query}"
                                                                                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                                                               FontSize="13"
                                                                                               TextTrimming="CharacterEllipsis"
                                                                                               VerticalAlignment="Center"/>
                                                                                    <TextBlock Grid.Column="1"
                                                                                               Text="{Binding MetaText}"
                                                                                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                                                               FontSize="11"
                                                                                               Margin="10,0,4,0"
                                                                                               VerticalAlignment="Center"/>
                                                                                </Grid>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="hBd" Property="Background" Value="{DynamicResource AppButtonHoverBackgroundBrush}"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>

                                                                <Button Grid.Column="1"
                                                                        Content="✕"
                                                                        Margin="2,0,2,0"
                                                                        ToolTip="Eliminar esta búsqueda del historial"
                                                                        Tag="{Binding}"
                                                                        Style="{StaticResource IconButtonStyle}"
                                                                        Click="DeleteSingleHistoryItemButton_Click"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- Botón Buscar -->
                        <Button x:Name="SearchButton"
                                Grid.Column="2"
                                Margin="9,0,0,0"
                                Content="🔍 Buscar"
                                Padding="17,9"
                                FontSize="13"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="SearchButton_Click"/>

                        <!-- Botón Cancelar Búsqueda en Curso -->
                        <Button x:Name="CancelSearchButton"
                                Grid.Column="3"
                                Margin="7,0,0,0"
                                Content="Cancelar"
                                Visibility="Collapsed"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="CancelSearchButton_Click"/>

                        <!-- Botón Revertir a la Búsqueda Anterior -->
                        <Button x:Name="RevertSearchButton"
                                Grid.Column="4"
                                Margin="7,0,0,0"
                                Content="↩ Revertir"
                                Padding="11,8"
                                IsEnabled="False"
                                ToolTip="Volver a los resultados de la búsqueda anterior"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="RevertSearchButton_Click"/>

                        <!-- Botón Borrar Búsqueda Actual / Anterior -->
                        <Button x:Name="ClearSearchSessionButton"
                                Grid.Column="5"
                                Margin="6,0,0,0"
                                Content="🧹 Borrar"
                                Padding="11,8"
                                IsEnabled="False"
                                ToolTip="Borrar los resultados de la búsqueda actual y anterior"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="ClearSearchSessionButton_Click"/>

                        <!-- Botón Bloqueador de Anuncios ON/OFF con Advertencia -->
                        <Button x:Name="ToggleAdBlockButton"
                                Grid.Column="6"
                                Margin="8,0,0,0"
                                Content="🛡️ AdBlock: ON"
                                ToolTip="Bloqueador de anuncios y popups activo (evita errores de carga)"
                                Style="{StaticResource AdBlockOnButtonStyle}"
                                Click="ToggleAdBlockButton_Click"/>

                        <!-- Acceso rápido a Cafecito (visible incluso con panel lateral oculto) -->
                        <Button Grid.Column="7"
                                Margin="7,0,0,0"
                                Content="☕"
                                Padding="10,7"
                                ToolTip="Regálame un cafecito para seguir mejorándolo (cafecito.app/atomichead)"
                                Style="{StaticResource CafecitoButtonStyle}"
                                Click="DonateCafecitoButton_Click"/>

                        <!-- Indicador sutil de Modo Incógnito (si está activo) -->
                        <Border x:Name="IncognitoIndicatorBadge"
                                Grid.Column="8"
                                Margin="7,0,0,0"
                                Background="{DynamicResource AppSubtleBrush}"
                                BorderBrush="{DynamicResource AppAccentBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8,5"
                                Visibility="Collapsed"
                                Cursor="Hand"
                                ToolTip="Modo Incógnito activo: no se guarda historial de búsquedas ni reproducción. Haz clic para desactivar."
                                MouseLeftButtonUp="ToggleIncognitoFromBadge_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🕶️ Incógnito" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- Botón Ajustes Generales -->
                        <Button x:Name="OpenSettingsButton"
                                Grid.Column="9"
                                Margin="6,0,0,0"
                                Content="⚙ Ajustes"
                                Padding="11,7"
                                FontSize="12.5"
                                ToolTip="Abrir apartado de Ajustes (Temas, Privacidad, Descargas y Almacenamiento)"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OpenSettingsModalButton_Click"/>
                    </Grid>
                </Border>

                <!-- Cartel de Aviso cuando alguna página consultada no es compatible o falló -->
                <Border x:Name="SearchWarningBanner"
                        Grid.Row="1"
                        Background="{DynamicResource AppSubtleBrush}"
                        BorderBrush="{DynamicResource AppAccentBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="20,8"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SearchWarningBannerText"
                                   Grid.Column="0"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="1"
                                Content="✕"
                                Width="24"
                                Height="24"
                                Margin="8,0,0,0"
                                Style="{StaticResource IconButtonStyle}"
                                Click="DismissSearchWarningBanner_Click"/>
                    </Grid>
                </Border>

                <!-- Barra de Filtros por Página + Selector de Cuadrícula -->
                <Border x:Name="FilterBarBorder"
                        Grid.Row="2"
                        Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="20,7"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="FilterChipsItemsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,8,0"
                                                Tag="{Binding SiteId}"
                                                Cursor="Hand"
                                                Click="FilterChip_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="chipBd"
                                                            CornerRadius="15"
                                                            Padding="12,5"
                                                            Background="{DynamicResource AppButtonBackgroundBrush}"
                                                            BorderBrush="{DynamicResource AppButtonBorderBrush}"
                                                            BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Ellipse Width="7" Height="7" Fill="{Binding AccentHex}" Margin="0,0,6,0"/>
                                                            <TextBlock x:Name="chipLbl" Text="{Binding Label}" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                                                            <TextBlock x:Name="chipCnt" Text="{Binding Count, StringFormat=' ({0})'}" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="12"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="chipBd" Property="Background" Value="{DynamicResource AppAccentBrush}"/>
                                                            <Setter TargetName="chipBd" Property="BorderBrush" Value="{DynamicResource AppAccentBorderBrush}"/>
                                                            <Setter TargetName="chipLbl" Property="Foreground" Value="{DynamicResource AppAccentForegroundBrush}"/>
                                                            <Setter TargetName="chipCnt" Property="Foreground" Value="{DynamicResource AppAccentForegroundBrush}"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="chipBd" Property="BorderBrush" Value="{DynamicResource AppAccentBorderBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Selector de Cuadrícula (3, 4, 6 columnas) -->
                        <Border Grid.Column="1"
                                Margin="14,0,0,0"
                                Background="{DynamicResource AppSubtleBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="4,2"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⊞ Cuadrícula:"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="5,0,6,0"/>
                                <Button x:Name="GridCols3Btn"
                                        Content="3"
                                        Tag="3"
                                        ToolTip="Ver 3 videos por fila (12 por página)"
                                        Style="{StaticResource GridDensityButtonStyle}"
                                        Click="GridDensityButton_Click"/>
                                <Button x:Name="GridCols4Btn"
                                        Content="4"
                                        Tag="4"
                                        ToolTip="Ver 4 videos por fila (16 por página)"
                                        Style="{StaticResource GridDensityButtonStyle}"
                                        Click="GridDensityButton_Click"/>
                                <Button x:Name="GridCols6Btn"
                                        Content="6"
                                        Tag="6"
                                        ToolTip="Ver 6 videos por fila (24 por página)"
                                        Style="{StaticResource GridDensityButtonStyle}"
                                        Click="GridDensityButton_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Contenido Central: Cuadrícula dinámica de videos -->
                <Grid Grid.Row="3">
                    <ScrollViewer x:Name="GridScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="15,12,15,16">
                        <ItemsControl x:Name="VideosGridItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding SelectedGridColumns, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Top"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:VideoCardControl Video="{Binding}"
                                                               VideoSelected="VideoCardControl_VideoSelected"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Estado Inicial / Vacío -->
                    <StackPanel x:Name="EmptyStatePanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="480">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <Image Source="pack://application:,,,/Assets/icon.png"
                                   Width="66"
                                   Height="66"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>
                            <Image Source="pack://application:,,,/Assets/logo.png"
                                   Height="32"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   HorizontalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="EmptyStateIcon"
                                   Text="🎞️"
                                   FontSize="32"
                                   Visibility="Collapsed"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <TextBlock x:Name="EmptyStateTitle"
                                   Text="Busca videos en tus buscadores favoritos"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                        <TextBlock x:Name="EmptyStateSubtitle"
                                   Margin="0,8,0,0"
                                   Text="Ya tienes cargada una lista predeterminada de buscadores de video verificados. Escribe arriba lo que deseas ver y pasa el mouse sobre cada miniatura para previsualizar."
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   FontSize="13.5"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   LineHeight="20"/>
                    </StackPanel>

                    <!-- Cartel Central de Video / Página No Compatible cuando no se puede obtener video -->
                    <Border x:Name="IncompatibleSearchOverlay"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="490"
                            Background="{DynamicResource AppSurfaceBrush}"
                            BorderBrush="{DynamicResource AppAccentBorderBrush}"
                            BorderThickness="1.5"
                            CornerRadius="14"
                            Padding="26,22">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Color="#0E0E0F" Opacity="0.55"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="⚠️"
                                       FontSize="40"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8"/>
                            <TextBlock x:Name="IncompatibleSearchTitle"
                                       Text="Este enlace o página no es compatible"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       FontSize="17.5"
                                       FontWeight="Bold"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="IncompatibleSearchMessage"
                                       Margin="0,8,0,16"
                                       Text="No se pudo obtener ningún video compatible desde esta fuente (el sitio bloquea el acceso externo, requiere cuenta o utiliza protección DRM)."
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       FontSize="13"
                                       LineHeight="19"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="IncompatibleOpenBrowserButton"
                                        Content="🌐 Abrir en navegador"
                                        Margin="0,0,8,0"
                                        Visibility="Collapsed"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="IncompatibleOpenBrowserButton_Click"/>
                                <Button Content="Entendido"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="CloseIncompatibleSearchOverlay_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Overlay de Carga -->
                    <Border x:Name="LoadingOverlay"
                            Background="{DynamicResource AppOverlayBackgroundBrush}"
                            Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar Width="250"
                                         Height="5"
                                         IsIndeterminate="True"
                                         Background="{DynamicResource AppBorderBrush}"
                                         Foreground="{DynamicResource AppAccentBorderBrush}"
                                         BorderThickness="0"/>
                            <TextBlock x:Name="LoadingStatusText"
                                       Margin="0,14,0,0"
                                       Text="Conectando y recopilando videos..."
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       FontSize="14.5"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Barra Inferior de Paginación Dinámica -->
                <Border x:Name="PaginationBarBorder"
                        Grid.Row="4"
                        Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="22,11"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="PaginationSummaryText"
                                   Grid.Column="0"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   FontSize="12.5"
                                   VerticalAlignment="Center"/>

                        <!-- Selector de Cuadrícula en Barra Inferior -->
                        <Border Grid.Column="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{DynamicResource AppSubtleBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="4,2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⊞ Cuadrícula:"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="5,0,6,0"/>
                                <Button x:Name="BottomGridCols3Btn"
                                        Content="3"
                                        Tag="3"
                                        ToolTip="Ver 3 videos por fila (12 por página)"
                                        Style="{StaticResource GridDensityButtonStyle}"
                                        Click="GridDensityButton_Click"/>
                                <Button x:Name="BottomGridCols4Btn"
                                        Content="4"
                                        Tag="4"
                                        ToolTip="Ver 4 videos por fila (16 por página)"
                                        Style="{StaticResource GridDensityButtonStyle}"
                                        Click="GridDensityButton_Click"/>
                                <Button x:Name="BottomGridCols6Btn"
                                        Content="6"
                                        Tag="6"
                                        ToolTip="Ver 6 videos por fila (24 por página)"
                                        Style="{StaticResource GridDensityButtonStyle}"
                                        Click="GridDensityButton_Click"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button x:Name="PrevPageButton"
                                    Content="« Anterior"
                                    Margin="0,0,6,0"
                                    Padding="11,6"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="PrevPageButton_Click"/>

                            <ItemsControl x:Name="PageSelectorsItemsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="2,0"
                                                MinWidth="34"
                                                Height="32"
                                                Tag="{Binding}"
                                                Cursor="Hand"
                                                Click="PageSelectorButton_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="pgBd"
                                                            CornerRadius="7"
                                                            Padding="9,4"
                                                            Background="{DynamicResource AppButtonBackgroundBrush}"
                                                            BorderBrush="{DynamicResource AppButtonBorderBrush}"
                                                            BorderThickness="1">
                                                        <TextBlock x:Name="pgTxt"
                                                                   Text="{Binding Label}"
                                                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                                   FontSize="12.5"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter TargetName="pgBd" Property="Background" Value="{DynamicResource AppAccentBrush}"/>
                                                            <Setter TargetName="pgBd" Property="BorderBrush" Value="{DynamicResource AppAccentBorderBrush}"/>
                                                            <Setter TargetName="pgTxt" Property="Foreground" Value="{DynamicResource AppAccentForegroundBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsEllipsis}" Value="True">
                                                            <Setter TargetName="pgBd" Property="Background" Value="Transparent"/>
                                                            <Setter TargetName="pgBd" Property="BorderThickness" Value="0"/>
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsCurrent}" Value="False"/>
                                                                <Condition Binding="{Binding IsEllipsis}" Value="False"/>
                                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter TargetName="pgBd" Property="Background" Value="{DynamicResource AppButtonHoverBackgroundBrush}"/>
                                                        </MultiDataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button x:Name="NextPageButton"
                                    Content="Siguiente »"
                                    Margin="6,0,0,0"
                                    Padding="11,6"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="NextPageButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <!-- Fin de SearchAreaGrid -->
        </Grid>

            <!-- ==================== 3) ÁREA DEDICADA DE DESCARGAS (VIDEO MP4 & AUDIO MP3) ==================== -->
            <Grid x:Name="DownloaderAreaGrid" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Barra Superior de Navegación del Descargador -->
                <Border Grid.Row="0"
                        Background="{DynamicResource AppHeaderBackgroundBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="22,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Botones de Navegación: Regresar al Menú Inicial y al Buscador Web -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="🏠 Menú Inicial"
                                    Padding="11,7"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="Volver a la pantalla de bienvenida y menú inicial"
                                    Click="NavToHomeMenu_Click"/>

                            <Button Content="🌐 Buscador Web"
                                    Padding="11,7"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="Abrir el buscador web"
                                    Click="NavToBrowserArea_Click"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/Assets/icon.png"
                                   Width="22"
                                   Height="22"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   Margin="0,0,8,0"/>
                            <Image Source="pack://application:,,,/Assets/logo.png"
                                   Height="17"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   Margin="0,0,10,0"/>
                            <TextBlock Text="— 📥 Descargador Universal Multimedia"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="📥 Cola de Descargas"
                                    Margin="0,0,7,0"
                                    Padding="11,7"
                                    ToolTip="Ver historial y cola de espera de descargas"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="ToggleDownloadQueueDrawer_Click"/>
                            <Button Content="⚙ Ajustes"
                                    Margin="0,0,7,0"
                                    Padding="11,7"
                                    ToolTip="Abrir apartado de Ajustes"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OpenSettingsModalButton_Click"/>
                            <Button Content="☕"
                                    Padding="10,7"
                                    ToolTip="Regálame un cafecito (cafecito.app/atomichead)"
                                    Style="{StaticResource CafecitoButtonStyle}"
                                    Click="DonateCafecitoButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Contenido Principal del Descargador -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="24,20">
                    <StackPanel MaxWidth="820" HorizontalAlignment="Center">

                        <!-- Tarjeta de Páginas Soportadas Específicamente (sin mención de NSFW) -->
                        <Border Background="{DynamicResource AppSurfaceBrush}"
                                BorderBrush="{DynamicResource AppCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18,14"
                                Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="🌐 Plataformas soportadas específicamente para descarga:"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10"/>

                                <WrapPanel>
                                    <Border Background="{DynamicResource AppSubtleBrush}" BorderBrush="{DynamicResource AppAccentBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10,6" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🔴" FontSize="11" Margin="0,0,5,0"/>
                                            <TextBlock Text="YouTube" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="12" FontWeight="Bold"/>
                                            <TextBlock Text=" (Videos, Shorts)" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="11.5" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource AppSubtleBrush}" BorderBrush="{DynamicResource AppAccentBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10,6" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🟣" FontSize="11" Margin="0,0,5,0"/>
                                            <TextBlock Text="Twitch" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="12" FontWeight="Bold"/>
                                            <TextBlock Text=" (Clips, VODs)" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="11.5" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource AppSubtleBrush}" BorderBrush="{DynamicResource AppAccentBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10,6" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="⚫" FontSize="11" Margin="0,0,5,0"/>
                                            <TextBlock Text="TikTok" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="12" FontWeight="Bold"/>
                                            <TextBlock Text=" (Videos y clips)" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="11.5" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource AppSubtleBrush}" BorderBrush="{DynamicResource AppAccentBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10,6" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🟠" FontSize="11" Margin="0,0,5,0"/>
                                            <TextBlock Text="Instagram" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="12" FontWeight="Bold"/>
                                            <TextBlock Text=" (Reels, Posts)" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="11.5" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource AppSubtleBrush}" BorderBrush="{DynamicResource AppAccentBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10,6" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🔵" FontSize="11" Margin="0,0,5,0"/>
                                            <TextBlock Text="Dailymotion" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="12" FontWeight="Bold"/>
                                            <TextBlock Text=" (Videos Full HD)" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="11.5" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Tarjeta de Ingreso de Enlace y Opciones -->
                        <Border Background="{DynamicResource AppSurfaceBrush}"
                                BorderBrush="{DynamicResource AppCardBorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="14"
                                Padding="24,20"
                                Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="Enlace del video a descargar:"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,7"/>

                                <Grid Margin="0,0,0,14">
                                    <TextBox x:Name="DownloaderUrlTextBox"
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             FontSize="13.5"
                                             Padding="12,10,95,10"
                                             KeyDown="DownloaderUrlTextBox_KeyDown"
                                             TextChanged="DownloaderUrlTextBox_TextChanged"/>

                                    <TextBlock Text="Pega aquí el enlace https://... del video"
                                               Foreground="{DynamicResource AppTextMutedBrush}"
                                               FontSize="13"
                                               Margin="14,0,100,0"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=DownloaderUrlTextBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Botones pegar y limpiar -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Button x:Name="DownloaderClearUrlBtn"
                                                Content="✕"
                                                Width="26"
                                                Height="26"
                                                FontSize="11"
                                                Visibility="Collapsed"
                                                ToolTip="Limpiar enlace"
                                                Style="{StaticResource IconButtonStyle}"
                                                Click="DownloaderClearUrlBtn_Click"/>

                                        <Button Content="📋 Pegar"
                                                Padding="8,4"
                                                FontSize="11.5"
                                                ToolTip="Pegar enlace copiado en el portapapeles"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="DownloaderPasteUrlBtn_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Detección de Plataforma según la URL escrita -->
                                <Border x:Name="DownloaderDetectedPlatformBorder"
                                        Background="{DynamicResource AppSubtleBrush}"
                                        BorderBrush="{DynamicResource AppAccentBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="10,6"
                                        Margin="0,0,0,14"
                                        Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="✓ Plataforma detectada: " Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="12"/>
                                        <TextBlock x:Name="DownloaderDetectedPlatformText" Text="YouTube" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <!-- Detección de Playlist de YouTube -->
                                <Border x:Name="DownloaderPlaylistDetectedBorder"
                                        Background="{DynamicResource AppSubtleBrush}"
                                        BorderBrush="{DynamicResource AppAccentBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,8"
                                        Margin="0,0,0,14"
                                        Visibility="Collapsed">
                                    <CheckBox x:Name="DownloaderDownloadFullPlaylistCheckBox"
                                              IsChecked="True"
                                              VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📑 Descargar Lista de Reproducción Completa (Playlist)"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                       FontSize="12.5"
                                                       FontWeight="Bold"/>
                                            <TextBlock Text=" — Descargará todos los videos/canciones en una subcarpeta organizada"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                       FontSize="12"
                                                       Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </CheckBox>
                                </Border>

                                <!-- Selección de Formato: Video (MP4) o Audio (MP3) -->
                                <TextBlock Text="Selecciona qué deseas descargar:"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,9"/>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Opción Video MP4 -->
                                    <RadioButton x:Name="DownloaderFormatVideoRadio"
                                                 Grid.Column="0"
                                                 GroupName="DownloaderFormat"
                                                 IsChecked="True"
                                                 Checked="DownloaderFormatRadio_Checked">
                                        <RadioButton.Template>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Border x:Name="fmtBd"
                                                        Background="{DynamicResource AppButtonBackgroundBrush}"
                                                        BorderBrush="{DynamicResource AppButtonBorderBrush}"
                                                        BorderThickness="1.5"
                                                        CornerRadius="10"
                                                        Padding="16,13"
                                                        Cursor="Hand">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="🎥" FontSize="18" Margin="0,0,8,0"/>
                                                            <TextBlock x:Name="fmtTitle" Text="Video Completo (MP4)" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="13.5" FontWeight="Bold"/>
                                                        </StackPanel>
                                                        <TextBlock x:Name="fmtSub" Text="Descarga el video con audio en alta resolución" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="11.5" Margin="26,4,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="fmtBd" Property="Background" Value="{DynamicResource AppSubtleBrush}"/>
                                                        <Setter TargetName="fmtBd" Property="BorderBrush" Value="{DynamicResource AppAccentBorderBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="fmtBd" Property="BorderBrush" Value="{DynamicResource AppAccentBorderBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </RadioButton.Template>
                                    </RadioButton>

                                    <!-- Opción Audio MP3 -->
                                    <RadioButton x:Name="DownloaderFormatAudioRadio"
                                                 Grid.Column="2"
                                                 GroupName="DownloaderFormat"
                                                 Checked="DownloaderFormatRadio_Checked">
                                        <RadioButton.Template>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Border x:Name="fmtBd"
                                                        Background="{DynamicResource AppButtonBackgroundBrush}"
                                                        BorderBrush="{DynamicResource AppButtonBorderBrush}"
                                                        BorderThickness="1.5"
                                                        CornerRadius="10"
                                                        Padding="16,13"
                                                        Cursor="Hand">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="🎵" FontSize="18" Margin="0,0,8,0"/>
                                                            <TextBlock x:Name="fmtTitle" Text="Solo Audio (MP3)" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="13.5" FontWeight="Bold"/>
                                                        </StackPanel>
                                                        <TextBlock x:Name="fmtSub" Text="Extrae la pista de sonido en MP3 de alta fidelidad" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="11.5" Margin="26,4,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="fmtBd" Property="Background" Value="{DynamicResource AppSubtleBrush}"/>
                                                        <Setter TargetName="fmtBd" Property="BorderBrush" Value="{DynamicResource AppAccentBorderBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="fmtBd" Property="BorderBrush" Value="{DynamicResource AppAccentBorderBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </RadioButton.Template>
                                    </RadioButton>
                                </Grid>

                                <!-- Opciones secundarias: Calidad de Video y Carpeta de Destino -->
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="1.4*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Selector de Calidad (solo activo si formato es Video) -->
                                    <StackPanel x:Name="DownloaderQualityPanel" Grid.Column="0">
                                        <TextBlock Text="Calidad de video:" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                        <ComboBox x:Name="DownloaderQualityComboBox"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  Height="36"
                                                  FontSize="12.5"/>
                                    </StackPanel>

                                    <!-- Panel informativo para MP3 -->
                                    <StackPanel x:Name="DownloaderAudioInfoPanel" Grid.Column="0" Visibility="Collapsed">
                                        <TextBlock Text="Calidad de audio:" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                        <Border Background="{DynamicResource AppSubtleBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Height="36" Padding="10,0">
                                            <TextBlock Text="MP3 Máxima Calidad (V0 / 320 kbps)" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Carpeta de Descargas -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Carpeta de destino:" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                        <Grid>
                                            <TextBox x:Name="DownloaderFolderTextBox"
                                                     Style="{StaticResource ModernTextBoxStyle}"
                                                     Height="36"
                                                     FontSize="12"
                                                     Padding="10,8,75,8"
                                                     IsReadOnly="True"/>
                                            <Button Content="📁 Cambiar"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,5,0"
                                                    Padding="8,5"
                                                    FontSize="11"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="DownloaderBrowseFolderBtn_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <!-- Botones de Descarga: Iniciar Directa o Agregar a la Cola Secuencial -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="DownloaderStartButton"
                                            Grid.Column="0"
                                            Content="⬇ Iniciar Descarga Directa"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Padding="20,12"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="DownloaderStartButton_Click"/>
                                    <Button x:Name="DownloaderEnqueueButton"
                                            Grid.Column="2"
                                            Content="📥 Agregar a la Cola"
                                            FontSize="13.5"
                                            FontWeight="SemiBold"
                                            Padding="18,12"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            ToolTip="Agrega esta descarga a la lista de espera secuencial en segundo plano"
                                            Click="DownloaderEnqueueButton_Click"/>
                                </Grid>

                                <!-- Barra y Estado de Progreso de Descarga en Vivo -->
                                <Border x:Name="DownloaderProgressBorder"
                                        Margin="0,16,0,0"
                                        Background="{DynamicResource AppSubtleBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="16,13"
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock x:Name="DownloaderProgressStatusText"
                                                       Text="Conectando y analizando video..."
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <Button x:Name="DownloaderCancelButton"
                                                    HorizontalAlignment="Right"
                                                    Content="Cancelar"
                                                    FontSize="11"
                                                    Padding="8,4"
                                                    Style="{StaticResource DangerButtonStyle}"
                                                    Click="DownloaderCancelButton_Click"/>
                                        </Grid>

                                        <ProgressBar x:Name="DownloaderProgressBar"
                                                     Height="8"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="0"
                                                     Background="{DynamicResource AppBorderBrush}"
                                                     Foreground="{DynamicResource AppAccentBorderBrush}"
                                                     BorderThickness="0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Cartel de Resultado / Éxito -->
                                <Border x:Name="DownloaderSuccessBorder"
                                        Margin="0,14,0,0"
                                        Background="{DynamicResource AppSubtleBrush}"
                                        BorderBrush="{DynamicResource AppAccentBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="16,13"
                                        Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="✓ Descarga completada con éxito"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                       FontSize="13"
                                                       FontWeight="Bold"/>
                                            <TextBlock x:Name="DownloaderSuccessFileNameText"
                                                       Text="video.mp4"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="▶ Reproducir / Abrir"
                                                    Padding="10,6"
                                                    FontSize="11.5"
                                                    Margin="0,0,6,0"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Click="DownloaderOpenCompletedFileBtn_Click"/>

                                            <Button Content="📂 Abrir carpeta"
                                                    Padding="10,6"
                                                    FontSize="11.5"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="DownloaderOpenCompletedFolderBtn_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Cartel de Error -->
                                <Border x:Name="DownloaderErrorBorder"
                                        Margin="0,14,0,0"
                                        Background="{DynamicResource AppSubtleBrush}"
                                        BorderBrush="{DynamicResource AppAccentBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="16,12"
                                        Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="DownloaderErrorText"
                                                   Grid.Column="0"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                Content="✕"
                                                Width="22"
                                                Height="22"
                                                Margin="8,0,0,0"
                                                Style="{StaticResource IconButtonStyle}"
                                                Click="DownloaderDismissErrorBtn_Click"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Historial de Descargas Recientes de la Sesión -->
                        <Border x:Name="DownloaderRecentSectionBorder"
                                Background="{DynamicResource AppSurfaceBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18,14"
                                Margin="0,0,0,20"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="📁 Descargas completadas en esta sesión:"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10"/>

                                <ItemsControl x:Name="DownloaderRecentItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource AppSubtleBrush}"
                                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="12,8"
                                                    Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0"
                                                            Background="{DynamicResource AppAccentBrush}"
                                                            BorderBrush="{DynamicResource AppAccentBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="5"
                                                            Padding="6,2"
                                                            Margin="0,0,10,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FormatType}"
                                                                   Foreground="{DynamicResource AppAccentForegroundBrush}"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FileName}"
                                                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Timestamp}"
                                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                                   FontSize="10.5"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="▶"
                                                                ToolTip="Abrir archivo"
                                                                Tag="{Binding FilePath}"
                                                                Padding="8,4"
                                                                Margin="0,0,4,0"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Click="RecentDownloadOpenFile_Click"/>
                                                        <Button Content="📂"
                                                                ToolTip="Ver en carpeta"
                                                                Tag="{Binding FilePath}"
                                                                Padding="8,4"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Click="RecentDownloadOpenFolder_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ==================== 4) BUSCADOR WEB CON ATAJOS ==================== -->
            <Grid x:Name="BrowserAreaGrid" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Barra Superior de Navegación del Buscador Web -->
                <Border Grid.Row="0"
                        Background="{DynamicResource AppHeaderBackgroundBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,11">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Navegación: Menú, Atajos, Historial, Atrás, Adelante, Recargar -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Button Content="🏠 Menú"
                                    Padding="9,7"
                                    FontSize="12"
                                    ToolTip="Volver al menú inicial de opciones"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="NavToHomeMenu_Click"/>

                            <Button x:Name="BrowserSpeedDialTabBtn"
                                    Content="⭐ Atajos"
                                    Margin="6,0,0,0"
                                    Padding="9,7"
                                    FontSize="12"
                                    ToolTip="Mostrar pantalla de atajos y portales favoritos"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BrowserShowSpeedDial_Click"/>

                            <Button x:Name="BrowserHistoryTabBtn"
                                    Content="🕒 Historial"
                                    Margin="6,0,0,0"
                                    Padding="9,7"
                                    FontSize="12"
                                    ToolTip="Abrir apartado de historial de búsqueda y navegación en lista"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BrowserShowHistory_Click"/>

                            <!-- Indicador de Modo Incógnito en el Buscador Web -->
                            <Border x:Name="BrowserIncognitoBadge"
                                    Margin="6,0,0,0"
                                    Background="{DynamicResource AppAccentBrush}"
                                    BorderBrush="{DynamicResource AppAccentBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,5"
                                    Cursor="Hand"
                                    Visibility="Collapsed"
                                    ToolTip="Modo Incógnito activo: no se guarda historial en el Buscador Web ni en la BETA. Haz clic para desactivar."
                                    MouseLeftButtonUp="ToggleIncognitoFromBadge_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🕶️ Incógnito" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="11.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>

                            <Button x:Name="BrowserBackBtn"
                                    Content="◀"
                                    Width="32"
                                    Height="32"
                                    Margin="6,0,0,0"
                                    FontSize="13"
                                    ToolTip="Página anterior"
                                    Style="{StaticResource IconButtonStyle}"
                                    Click="BrowserBackBtn_Click"/>

                            <Button x:Name="BrowserForwardBtn"
                                    Content="▶"
                                    Width="32"
                                    Height="32"
                                    Margin="3,0,0,0"
                                    FontSize="13"
                                    ToolTip="Página siguiente"
                                    Style="{StaticResource IconButtonStyle}"
                                    Click="BrowserForwardBtn_Click"/>

                            <Button x:Name="BrowserReloadBtn"
                                    Content="🔄"
                                    Width="32"
                                    Height="32"
                                    Margin="3,0,0,0"
                                    FontSize="13"
                                    ToolTip="Recargar página actual"
                                    Style="{StaticResource IconButtonStyle}"
                                    Click="BrowserReloadBtn_Click"/>
                        </StackPanel>

                        <!-- Caja de Dirección URL y Búsqueda Web -->
                        <Grid Grid.Column="1" Margin="4,0,10,0">
                            <TextBox x:Name="BrowserUrlTextBox"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     FontSize="13.5"
                                     Padding="12,8,80,8"
                                     KeyDown="BrowserUrlTextBox_KeyDown"/>

                            <TextBlock Text="Buscar videos en la web o escribir enlace https://..."
                                       Foreground="{DynamicResource AppTextMutedBrush}"
                                       FontSize="13"
                                       Margin="14,0,85,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=BrowserUrlTextBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Botón Ir / Navegar -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Button Content="Ir ➔"
                                        Padding="10,5"
                                        FontSize="11.5"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="BrowserNavigateBtn_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- Acciones Rápidas: Descargar Video (con Aura), Guardar en Atajos y Cola de Descargas -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="BrowserTopDownloadGlowBorder"
                                    Margin="0,0,8,0"
                                    Background="{DynamicResource AppAccentBrush}"
                                    BorderBrush="{DynamicResource AppAccentBorderBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="8"
                                    Padding="12,6"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="BrowserFloatingDownloadButton_Click"
                                    ToolTip="Detectar y descargar el video de la página actual a la cola de descargas">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="BrowserTopDownloadGlow"
                                                      BlurRadius="18"
                                                      ShadowDepth="0"
                                                      Color="{DynamicResource AppGlowColor}"
                                                      Opacity="0.85"/>
                                </Border.Effect>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="BrowserTopDownloadGlow"
                                                                 Storyboard.TargetProperty="BlurRadius"
                                                                 From="12" To="26" Duration="0:0:1.5" AutoReverse="True"/>
                                                <DoubleAnimation Storyboard.TargetName="BrowserTopDownloadGlow"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 From="0.55" To="0.98" Duration="0:0:1.5" AutoReverse="True"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⬇" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Descargar Video" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Button x:Name="BrowserAddBookmarkBtn"
                                    Content="⭐ Guardar Atajo"
                                    Padding="10,7"
                                    FontSize="12"
                                    Margin="0,0,7,0"
                                    ToolTip="Agregar esta página a tus atajos rápidos"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BrowserAddCurrentPageToShortcuts_Click"/>

                            <Button x:Name="BrowserQueueBadgeBtn"
                                    Content="📥 Cola de Descargas"
                                    Padding="12,7"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    ToolTip="Abrir cola y lista de espera de descargas"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="ToggleDownloadQueueDrawer_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Área de Contenido: 1) Atajos, 2) Apartado de Historial (Página Aparte), 3) Placeholder Airspace, 4) WebView2 Real -->
                <Grid Grid.Row="1">
                    <!-- 1. Pantalla de Atajos (Speed Dial) -->
                    <ScrollViewer x:Name="BrowserSpeedDialScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="24,24">
                        <StackPanel MaxWidth="920" HorizontalAlignment="Center">
                            <!-- Botón para volver a la página activa si ya había una abierta -->
                            <Button x:Name="SpeedDialReturnToWebBtn"
                                    Content="↩ Volver al Video / Página Actual"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,16"
                                    Padding="18,9"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Visibility="Collapsed"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="BrowserReturnToActiveWeb_Click"/>

                            <!-- Encabezado de Atajos -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,14">
                                <Image Source="pack://application:,,,/Assets/icon.png"
                                       Width="38"
                                       Height="38"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       Margin="0,0,10,0"/>
                                <Image Source="pack://application:,,,/Assets/logo.png"
                                       Height="28"
                                       Stretch="Uniform"
                                       VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </StackPanel>

                            <TextBlock Text="Buscador Web"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,6"/>

                            <TextBlock Text="Entra a tus portales favoritos, inicia sesión con tus cuentas para conservar tus suscripciones e historiales, y reproduce cualquier video para descargarlo a tu lista de espera."
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       FontSize="13"
                                       TextAlignment="Center"
                                       LineHeight="19"
                                       MaxWidth="680"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,26"/>

                            <!-- Barra de herramientas de Atajos -->
                            <Grid Margin="0,0,0,14">
                                <TextBlock Text="📌 Tus Atajos Guardados:"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                                <Button Content="➕ Agregar Nuevo Atajo"
                                        HorizontalAlignment="Right"
                                        Padding="11,6"
                                        FontSize="12"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="OpenAddShortcutModal_Click"/>
                            </Grid>

                            <!-- Cuadrícula de Atajos Dinámicos -->
                            <ItemsControl x:Name="BrowserShortcutsItemsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="190"
                                                Height="100"
                                                Margin="8"
                                                Background="{DynamicResource AppSurfaceBrush}"
                                                BorderBrush="{DynamicResource AppCardBorderBrush}"
                                                BorderThickness="1.5"
                                                CornerRadius="12"
                                                Padding="14,12"
                                                Cursor="Hand"
                                                Tag="{Binding}"
                                                MouseLeftButtonUp="ShortcutCard_Click">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Color="#0E0E0F" Opacity="0.35"/>
                                            </Border.Effect>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding IconEmoji}" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="115"/>
                                                    </StackPanel>
                                                    <Button Content="✕"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Width="20"
                                                            Height="20"
                                                            FontSize="9"
                                                            Tag="{Binding}"
                                                            Style="{StaticResource IconButtonStyle}"
                                                            Click="DeleteShortcut_Click"/>
                                                </Grid>

                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding Url}"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                           FontSize="10.5"
                                                           VerticalAlignment="Bottom"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 2. Apartado de Historial del Buscador Web (Página Aparte Solo en Lista) -->
                    <ScrollViewer x:Name="BrowserHistoryPageScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="28,24"
                                  Visibility="Collapsed">
                        <StackPanel MaxWidth="860" HorizontalAlignment="Stretch">
                            <!-- Cabecera de la página de Historial -->
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🕒" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Historial del Buscador Web"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Haz clic sobre cualquier entrada de la lista para volver a abrir esa página o video en el navegador."
                                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                                               FontSize="12.5"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <Button x:Name="BrowserHistoryReturnToWebBtn"
                                        Grid.Column="1"
                                        Content="↩ Volver al Video / Página Actual"
                                        Margin="0,0,10,0"
                                        Padding="14,8"
                                        FontSize="12.5"
                                        FontWeight="Bold"
                                        Visibility="Collapsed"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="BrowserReturnToActiveWeb_Click"/>

                                <Button Grid.Column="2"
                                        Content="🗑 Limpiar Todo el Historial"
                                        Padding="13,8"
                                        FontSize="12"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="BrowserClearHistory_Click"/>
                            </Grid>

                            <!-- Estado vacío si no hay items -->
                            <Border x:Name="BrowserHistoryEmptyState"
                                    Background="{DynamicResource AppSurfaceBrush}"
                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="12"
                                    Padding="32"
                                    Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🕒" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="El historial de navegación está vacío"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Las páginas y videos que visites en el Buscador Web aparecerán listados aquí automáticamente."
                                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                                               FontSize="12.5"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Items del historial solo en lista -->
                            <ItemsControl x:Name="BrowserHistoryItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource AppSurfaceBrush}"
                                                BorderBrush="{DynamicResource AppCardBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="16,12"
                                                Margin="0,0,0,8"
                                                Cursor="Hand"
                                                MouseLeftButtonUp="BrowserHistoryItem_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Width="34"
                                                        Height="34"
                                                        CornerRadius="8"
                                                        Background="{DynamicResource AppSubtleBrush}"
                                                        BorderBrush="{DynamicResource AppAccentBorderBrush}"
                                                        BorderThickness="1"
                                                        Margin="0,0,12,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="🌐" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}"
                                                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                               FontSize="13.5"
                                                               FontWeight="Bold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Url}"
                                                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                               FontSize="11.5"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,3,0,0"/>
                                                </StackPanel>

                                                <Border Grid.Column="2"
                                                        Background="{DynamicResource AppSubtleBrush}"
                                                        CornerRadius="6"
                                                        Padding="8,4"
                                                        VerticalAlignment="Center"
                                                        Margin="12,0,12,0">
                                                    <TextBlock Text="{Binding FormattedTime}"
                                                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"/>
                                                </Border>

                                                <Button Grid.Column="3"
                                                        Content="✕"
                                                        Width="28"
                                                        Height="28"
                                                        FontSize="11"
                                                        Tag="{Binding}"
                                                        ToolTip="Eliminar esta entrada del historial"
                                                        Style="{StaticResource IconButtonStyle}"
                                                        Click="BrowserDeleteHistoryItem_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 3. Panel de Respaldo Visual mientras un Modal/Cajón está abierto (evita bloqueo de Airspace HwndHost) -->
                    <Border x:Name="BrowserAirspacePlaceholderBorder"
                            Background="{DynamicResource AppBackgroundBrush}"
                            Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/Assets/icon.png"
                                   Width="48"
                                   Height="48"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   Opacity="0.65"
                                   Margin="0,0,0,12"/>
                            <TextBlock Text="Navegador en pausa mientras interactúas con el panel superpuesto"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 4. WebView2 de Navegación Real (con Botón Flotante de Descarga inyectado en DOM) -->
                    <wv2:WebView2 x:Name="BrowserWebView" Visibility="Collapsed"/>
                </Grid>

                <!-- Barra Inferior Fuera del HwndHost (Notificaciones Toast + Barra de Video Detectado) -->
                <Grid Grid.Row="2">
                    <StackPanel>
                        <!-- Notificación Toast -->
                        <Border x:Name="BrowserToastBorder"
                                Background="{DynamicResource AppSurfaceBrush}"
                                BorderBrush="{DynamicResource AppAccentBorderBrush}"
                                BorderThickness="0,1.5,0,0"
                                Padding="18,10"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="BrowserToastIconText" Text="✓" FontSize="14" Margin="0,0,8,0" Foreground="{DynamicResource AppAccentTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="BrowserToastText"
                                           Text="Video agregado a la cola"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Barra Inferior de Detección Automática de Videos -->
                        <Border x:Name="BrowserVideoDetectionBar"
                                Background="{DynamicResource AppHeaderBackgroundBrush}"
                                BorderBrush="{DynamicResource AppAccentBorderBrush}"
                                BorderThickness="0,2,0,0"
                                Padding="20,10"
                                Visibility="Collapsed">
                            <Grid MaxWidth="980">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="⚡" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="¡VIDEO DETECTADO EN ESTA PÁGINA!" Foreground="{DynamicResource AppAccentTextBrush}" FontSize="10.5" FontWeight="Bold"/>
                                    <TextBlock x:Name="BrowserDetectedVideoTitleText" Text="Título del video..." Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <Button x:Name="BrowserDownloadDetectedButton"
                                        Grid.Column="2"
                                        Content="⬇ DESCARGAR VIDEO"
                                        Padding="18,8"
                                        FontSize="12.5"
                                        FontWeight="Bold"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="BrowserDownloadDetectedButton_Click"/>

                                <Button Grid.Column="3"
                                        Content="✕"
                                        Margin="8,0,0,0"
                                        Width="26"
                                        Height="26"
                                        FontSize="11"
                                        Style="{StaticResource IconButtonStyle}"
                                        Click="BrowserDismissDetection_Click"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- ==================== MODAL DE AJUSTES GENERALES ==================== -->
        <Border x:Name="SettingsModalOverlay"
                Panel.ZIndex="35"
                Background="{DynamicResource AppOverlayBackgroundBrush}"
                Visibility="Collapsed">
            <Border Width="620"
                    MaxHeight="700"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1.5"
                    CornerRadius="16"
                    Padding="26,22">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Color="#0E0E0F" Opacity="0.6"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Cabecera del Modal -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚙" FontSize="20" Margin="0,0,8,0"/>
                            <TextBlock Text="Ajustes y Personalización"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                        </StackPanel>
                        <Button Content="✕"
                                HorizontalAlignment="Right"
                                Width="28"
                                Height="28"
                                Style="{StaticResource IconButtonStyle}"
                                Click="CloseSettingsModal_Click"/>
                    </Grid>

                    <!-- Contenido con secciones limpias -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="520" Margin="0,0,-8,0" Padding="0,0,8,0">
                        <StackPanel>
                            <!-- SECCIÓN 1: APARIENCIA Y TEMAS (Solo Oscuro Predeterminado y Blanco) -->
                            <Border Background="{DynamicResource AppSubtleBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="🎨 Apariencia y Tema de la Aplicación"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                                               FontSize="13.5"
                                               FontWeight="Bold"
                                               Margin="0,0,0,10"/>

                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Tema Oscuro (Default) -->
                                        <RadioButton x:Name="ThemeDarkRadio"
                                                     Grid.Column="0"
                                                     GroupName="AppThemeGroup"
                                                     Checked="ThemeRadio_Checked">
                                            <RadioButton.Template>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border x:Name="bd" Background="{DynamicResource AppButtonBackgroundBrush}" BorderBrush="{DynamicResource AppButtonBorderBrush}" BorderThickness="1.5" CornerRadius="8" Padding="10,12" Cursor="Hand">
                                                        <StackPanel HorizontalAlignment="Center">
                                                            <TextBlock Text="🌙" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                            <TextBlock x:Name="tTitle" Text="Oscuro" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                            <TextBlock x:Name="tSub" Text="Predeterminado (ChasClip)" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="10.5" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AppAccentBorderBrush}"/>
                                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AppAccentBrush}"/>
                                                            <Setter TargetName="tTitle" Property="Foreground" Value="{DynamicResource AppAccentForegroundBrush}"/>
                                                            <Setter TargetName="tSub" Property="Foreground" Value="{DynamicResource AppAccentForegroundBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </RadioButton.Template>
                                        </RadioButton>

                                        <!-- Tema Blanco -->
                                        <RadioButton x:Name="ThemeLightRadio"
                                                     Grid.Column="2"
                                                     GroupName="AppThemeGroup"
                                                     Checked="ThemeRadio_Checked">
                                            <RadioButton.Template>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border x:Name="bd" Background="{DynamicResource AppButtonBackgroundBrush}" BorderBrush="{DynamicResource AppButtonBorderBrush}" BorderThickness="1.5" CornerRadius="8" Padding="10,12" Cursor="Hand">
                                                        <StackPanel HorizontalAlignment="Center">
                                                            <TextBlock Text="☀️" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                            <TextBlock x:Name="tTitle" Text="Blanco" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                            <TextBlock x:Name="tSub" Text="Luminoso" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="10.5" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AppAccentBorderBrush}"/>
                                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AppAccentBrush}"/>
                                                            <Setter TargetName="tTitle" Property="Foreground" Value="{DynamicResource AppAccentForegroundBrush}"/>
                                                            <Setter TargetName="tSub" Property="Foreground" Value="{DynamicResource AppAccentForegroundBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </RadioButton.Template>
                                        </RadioButton>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- SECCIÓN 3: IDIOMA DE LA APLICACIÓN -->
                            <Border Background="{DynamicResource AppSubtleBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock x:Name="SettingsLangSectionHeader"
                                               Text="🌐 Idioma de la Aplicación (Language)"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                                               FontSize="13.5"
                                               FontWeight="Bold"
                                               Margin="0,0,0,10"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <RadioButton x:Name="LangSpanishRadio"
                                                     Grid.Column="0"
                                                     GroupName="AppLangGroup"
                                                     Checked="LangRadio_Checked">
                                            <RadioButton.Template>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border x:Name="bd" Background="{DynamicResource AppInputBackgroundBrush}" BorderBrush="{DynamicResource AppInputBorderBrush}" BorderThickness="1.5" CornerRadius="8" Padding="12,10" Cursor="Hand">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <TextBlock Text="🇪🇸" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Español" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AppAccentBorderBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </RadioButton.Template>
                                        </RadioButton>

                                        <RadioButton x:Name="LangEnglishRadio"
                                                     Grid.Column="2"
                                                     GroupName="AppLangGroup"
                                                     Checked="LangRadio_Checked">
                                            <RadioButton.Template>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border x:Name="bd" Background="{DynamicResource AppInputBackgroundBrush}" BorderBrush="{DynamicResource AppInputBorderBrush}" BorderThickness="1.5" CornerRadius="8" Padding="12,10" Cursor="Hand">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <TextBlock Text="🇺🇸" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="English" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AppAccentBorderBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </RadioButton.Template>
                                        </RadioButton>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- SECCIÓN 2: PRIVACIDAD Y CONTENIDO -->
                            <Border Background="{DynamicResource AppSubtleBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="🕶️ Privacidad y Navegación"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                                               FontSize="13.5"
                                               FontWeight="Bold"
                                               Margin="0,0,0,10"/>

                                    <CheckBox x:Name="SettingsIncognitoCheckBox"
                                              Checked="SettingsIncognitoCheckBox_Changed"
                                              Unchecked="SettingsIncognitoCheckBox_Changed">
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock x:Name="SettingsIncognitoLabel"
                                                       Text="Activar Modo Incógnito"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock x:Name="SettingsIncognitoSubLabel"
                                                       Text="Cuando está activo, no se guardan búsquedas ni páginas en el historial del Buscador Web, ni búsquedas ni reproducciones en la BETA."
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                       FontSize="11.5"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </CheckBox>

                                    <!-- Casilla Contenido para adultos (+18) -->
                                    <CheckBox x:Name="SettingsAdultCheckBox"
                                              Margin="0,12,0,0"
                                              Checked="SettingsAdultCheckBox_Changed"
                                              Unchecked="SettingsAdultCheckBox_Changed">
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock x:Name="SettingsAdultLabel"
                                                       Text="Habilitar sección para adultos (+18)"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock x:Name="SettingsAdultSubLabel"
                                                       Text="Muestra el botón 'Páginas NSFW' en el panel lateral para explorar y buscar en portales adultos."
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                       FontSize="11.5"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </Border>

                            <!-- SECCIÓN 4: DESCARGAS Y PLAYLISTS -->
                            <Border Background="{DynamicResource AppSubtleBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="📥 Descargas y Carpetas"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                                               FontSize="13.5"
                                               FontWeight="Bold"
                                               Margin="0,0,0,10"/>

                                    <TextBlock Text="Carpeta de descargas predeterminada:"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                                               FontSize="12"
                                               Margin="0,0,0,6"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="SettingsDownloadDirTextBox"
                                                 Grid.Column="0"
                                                 IsReadOnly="True"
                                                 Style="{StaticResource ModernTextBoxStyle}"
                                                 FontSize="12"
                                                 Margin="0,0,8,0"/>
                                        <Button Grid.Column="1"
                                                Content="📁 Cambiar..."
                                                Padding="12,7"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="SettingsChangeDownloadDir_Click"/>
                                    </Grid>

                                    <CheckBox x:Name="SettingsPlaylistAutoCheckBox"
                                              IsChecked="True">
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock Text="Descargar playlist completa al detectar una lista de YouTube"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="Descarga todos los videos o canciones de la lista en una subcarpeta organizada."
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                       FontSize="11.5"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </Border>

                            <!-- SECCIÓN 5: GESTIÓN DE DATOS Y ALMACENAMIENTO -->
                            <Border Background="{DynamicResource AppSubtleBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14">
                                <StackPanel>
                                    <TextBlock Text="🧹 Datos y Almacenamiento Local (Historial y Datos de la BETA)"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                                               FontSize="13.5"
                                               FontWeight="Bold"
                                               Margin="0,0,0,10"/>

                                    <WrapPanel>
                                        <Button Content="Limpiar Historial de Búsquedas"
                                                Margin="0,0,8,8"
                                                Padding="11,7"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="SettingsClearSearchHistory_Click"/>
                                        <Button Content="Limpiar Historial de Reproducción"
                                                Margin="0,0,8,8"
                                                Padding="11,7"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="SettingsClearPlaybackHistory_Click"/>
                                        <Button Content="Vaciar Favoritos"
                                                Margin="0,0,8,8"
                                                Padding="11,7"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="SettingsClearFavorites_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Pie del Modal con Botón Guardar / Listo -->
                    <Border Grid.Row="2"
                            Margin="0,16,0,0"
                            Padding="0,14,0,0"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Listo / Guardar"
                                    Width="140"
                                    Padding="16,9"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="CloseSettingsModal_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Border>

        <!-- ==================== MODAL EDITAR PÁGINA GUARDADA ==================== -->
        <Border x:Name="EditSiteModalOverlay"
                Panel.ZIndex="20"
                Background="{DynamicResource AppOverlayBackgroundBrush}"
                Visibility="Collapsed">
            <Border Width="430"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppCardBorderBrush}"
                    BorderThickness="1.5"
                    CornerRadius="14"
                    Padding="22">
                <StackPanel>
                    <TextBlock Text="Editar Página Guardada"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               FontSize="17"
                               FontWeight="Bold"
                               Margin="0,0,0,16"/>

                    <TextBlock Text="Nombre:"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               FontSize="12.5"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="EditSiteNameTextBox"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Margin="0,0,0,12"/>

                    <TextBlock Text="Enlace (URL o plantilla {q}):"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               FontSize="12.5"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="EditSiteDomainTextBox"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Margin="0,0,0,18"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar"
                                Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="CancelEditSite_Click"/>
                        <Button Content="Guardar cambios"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="SaveEditSite_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ==================== MODAL ADVERTENCIA DESACTIVAR BLOQUEADOR DE ANUNCIOS ==================== -->
        <Border x:Name="AdBlockWarningModalOverlay"
                Panel.ZIndex="45"
                Background="{DynamicResource AppOverlayBackgroundBrush}"
                Visibility="Collapsed">
            <Border Width="470"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppAccentBorderBrush}"
                    BorderThickness="1.5"
                    CornerRadius="14"
                    Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="26" ShadowDepth="6" Color="#0E0E0F" Opacity="0.65"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="⚠️" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="¿Desactivar el Bloqueador de Anuncios?"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   FontSize="16.5"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Advertencia: El bloqueador integrado detiene ventanas emergentes (popups), redirecciones publicitarias, scripts invasivos y capas invisibles sobre los videos."
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               FontSize="13"
                               LineHeight="19"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>

                    <Border Background="{DynamicResource AppSubtleBrush}"
                            BorderBrush="{DynamicResource AppAccentBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,9"
                            Margin="0,0,0,18">
                        <TextBlock Text="Si lo desactivas, las páginas externas pueden lanzar anuncios superpuestos o redirecciones que pueden causar errores de carga y reproducción."
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   FontSize="12.5"
                                   FontWeight="Medium"
                                   LineHeight="18"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="🛡️ Mantener activado (Recomendado)"
                                Margin="0,0,8,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="CancelDisableAdBlock_Click"/>
                        <Button Content="Desactivar bajo mi riesgo"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="ConfirmDisableAdBlock_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ==================== REPRODUCTOR DE VIDEO INTEGRADO CON REGULADOR DE CALIDAD Y DESCARGA ==================== -->
        <Border x:Name="PlayerModalOverlay"
                Panel.ZIndex="30"
                Background="{DynamicResource AppOverlayBackgroundBrush}"
                Visibility="Collapsed">
            <Grid Margin="28,20">
                <Border Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppCardBorderBrush}"
                        BorderThickness="1.5"
                        CornerRadius="14"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Barra superior del reproductor: Sitio, Título, Regulador de Calidad, Descargar, Enlace y Cerrar -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource AppHeaderBackgroundBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="15,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border x:Name="PlayerSiteBadge"
                                        Grid.Column="0"
                                        CornerRadius="6"
                                        Padding="9,4"
                                        Margin="0,0,11,0"
                                        Background="{DynamicResource AppAccentBrush}"
                                        BorderBrush="{DynamicResource AppAccentBorderBrush}"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="PlayerSiteText"
                                               Foreground="{DynamicResource AppAccentForegroundBrush}"
                                               FontSize="12"
                                               FontWeight="Bold"/>
                                </Border>

                                <TextBlock x:Name="PlayerTitleText"
                                           Grid.Column="1"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           FontFamily="Segoe UI, Segoe UI Emoji, Yu Gothic UI, Malgun Gothic, Microsoft YaHei UI"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,14,0"/>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Regulador de Calidad -->
                                    <TextBlock Text="Calidad:"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>

                                    <ComboBox x:Name="PlayerQualityComboBox"
                                              Width="156"
                                              Margin="0,0,8,0"
                                              ToolTip="Regulador de calidad de reproducción y descarga"
                                              Style="{StaticResource ModernComboBoxStyle}"
                                              SelectionChanged="PlayerQualityComboBox_SelectionChanged"/>

                                    <!-- Botón Descargar en la calidad seleccionada -->
                                    <Button x:Name="DownloadVideoButton"
                                            Content="⬇ Descargar"
                                            Margin="0,0,8,0"
                                            Padding="13,7"
                                            ToolTip="Descargar este video en la calidad seleccionada en el regulador"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="DownloadVideoButton_Click"/>

                                    <Button x:Name="CopyVideoLinkButton"
                                            Content="📋 Copiar"
                                            Margin="0,0,7,0"
                                            ToolTip="Copiar enlace original del video"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="CopyVideoLinkButton_Click"/>

                                    <Button Content="🌐 Navegador"
                                            Margin="0,0,7,0"
                                            ToolTip="Abrir video en tu navegador predeterminado"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="OpenInBrowserButton_Click"/>

                                    <Button Content="✕ Cerrar"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="ClosePlayerButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Barra de progreso de descarga activa / notificación de calidad -->
                        <Border x:Name="PlayerDownloadBarBorder"
                                Grid.Row="1"
                                Background="{DynamicResource AppSubtleBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="16,7"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="PlayerDownloadStatusText"
                                           Grid.Column="0"
                                           Text="Preparando descarga..."
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,14,0"/>

                                <ProgressBar x:Name="PlayerDownloadProgressBar"
                                             Grid.Column="1"
                                             Height="6"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="0"
                                             VerticalAlignment="Center"
                                             Background="{DynamicResource AppBorderBrush}"
                                             Foreground="{DynamicResource AppAccentBorderBrush}"
                                             BorderThickness="0"/>

                                <Button x:Name="CancelDownloadButton"
                                        Grid.Column="2"
                                        Content="Cancelar descarga"
                                        FontSize="11.5"
                                        Padding="10,4"
                                        Margin="12,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="CancelDownloadButton_Click"/>
                            </Grid>
                        </Border>

                        <!-- Lienzo del Reproductor + Máscara de Carga + Cartel de No Compatible -->
                        <Grid Grid.Row="2" Background="{DynamicResource PaletteDarkBrush}" ClipToBounds="True">
                            <StackPanel x:Name="PlayerLoadingMask"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <ProgressBar Width="210"
                                             Height="4"
                                             IsIndeterminate="True"
                                             Background="{DynamicResource AppBorderBrush}"
                                             Foreground="{DynamicResource AppAccentBorderBrush}"
                                             BorderThickness="0"/>
                                <TextBlock Text="Preparando reproductor limpio..."
                                           Foreground="{DynamicResource PaletteLightBrush}"
                                           FontSize="13.5"
                                           Margin="0,12,0,0"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <wv2:WebView2 x:Name="PlayerWebView"/>

                            <!-- Cartel cuando no se puede obtener o reproducir el video -->
                            <Border x:Name="PlayerIncompatibleOverlay"
                                    Background="{DynamicResource AppOverlayBackgroundBrush}"
                                    Visibility="Collapsed">
                                <Border MaxWidth="470"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource AppSurfaceBrush}"
                                        BorderBrush="{DynamicResource AppAccentBorderBrush}"
                                        BorderThickness="1.5"
                                        CornerRadius="14"
                                        Padding="28,24">
                                    <StackPanel>
                                        <TextBlock Text="⚠️"
                                                   FontSize="42"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,10"/>
                                        <TextBlock Text="Este video no es compatible"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   TextAlignment="Center"/>
                                        <TextBlock x:Name="PlayerIncompatibleDetailText"
                                                   Margin="0,9,0,18"
                                                   Text="No se pudo obtener el video directamente en el reproductor integrado (el sitio bloquea la inserción externa, el archivo fue eliminado o el formato requiere reproducción en el navegador)."
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                   FontSize="13"
                                                   LineHeight="19"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="🌐 Abrir en navegador externo"
                                                    Margin="0,0,10,0"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Click="OpenInBrowserButton_Click"/>
                                            <Button Content="✕ Cerrar"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="ClosePlayerButton_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== MODAL AGREGAR NUEVO ATAJO AL BUSCADOR WEB ==================== -->
        <Border x:Name="AddShortcutModalOverlay"
                Panel.ZIndex="50"
                Background="{DynamicResource AppOverlayBackgroundBrush}"
                Visibility="Collapsed">
            <Border Width="440"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppCardBorderBrush}"
                    BorderThickness="1.5"
                    CornerRadius="14"
                    Padding="24">
                <StackPanel>
                    <TextBlock Text="➕ Agregar Nuevo Atajo"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               FontSize="17"
                               FontWeight="Bold"
                               Margin="0,0,0,14"/>

                    <TextBlock Text="Nombre del portal o página:"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               FontSize="12.5"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="NewShortcutTitleTextBox"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Margin="0,0,0,12"/>

                    <TextBlock Text="Enlace (URL https://...):"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               FontSize="12.5"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="NewShortcutUrlTextBox"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Margin="0,0,0,16"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar"
                                Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="CloseAddShortcutModal_Click"/>
                        <Button Content="Guardar Atajo"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="SaveNewShortcut_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ==================== MODAL DE DESCARGA DE VIDEO DETECTADO ==================== -->
        <Border x:Name="SnaptubeDownloadModalOverlay"
                Panel.ZIndex="55"
                Background="{DynamicResource AppOverlayBackgroundBrush}"
                Visibility="Collapsed">
            <Border Width="490"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppAccentBorderBrush}"
                    BorderThickness="1.5"
                    CornerRadius="16"
                    Padding="26,22">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="26" ShadowDepth="6" Color="#0E0E0F" Opacity="0.6"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="⚡" FontSize="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Descargar Video Detectado"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   FontSize="17.5"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Background="{DynamicResource AppSubtleBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <Border Background="{DynamicResource AppAccentBrush}"
                                        BorderBrush="{DynamicResource AppAccentBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="6,2"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Top">
                                    <TextBlock x:Name="SnaptubeModalStreamBadgeText"
                                               Text="HLS"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                                               FontSize="10"
                                               FontWeight="Bold"/>
                                </Border>
                                <TextBlock x:Name="SnaptubeModalTitleText"
                                           Text="Título del video..."
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                            </DockPanel>
                            <TextBlock x:Name="SnaptubeModalUrlText"
                                       Text="https://..."
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Selector de Flujo Detectado (estilo Video DownloadHelper cuando hay múltiples fuentes) -->
                    <StackPanel x:Name="SnaptubeModalStreamsPanel" Margin="0,0,0,12" Visibility="Collapsed">
                        <TextBlock Text="Flujos multimedia detectados en la página:"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5"/>
                        <ComboBox x:Name="SnaptubeModalStreamsComboBox"
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  DisplayMemberPath="DisplaySummary"
                                  Height="34"
                                  FontSize="11.5"
                                  SelectionChanged="SnaptubeModalStreamsComboBox_SelectionChanged"/>
                    </StackPanel>

                    <TextBlock Text="Selecciona qué deseas descargar:"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <!-- Opciones Video o Audio -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <RadioButton x:Name="SnaptubeModalVideoRadio"
                                     Grid.Column="0"
                                     GroupName="SnaptubeFormatGroup"
                                     IsChecked="True"
                                     Checked="SnaptubeModalFormat_Checked">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="bd" Background="{DynamicResource AppButtonBackgroundBrush}" BorderBrush="{DynamicResource AppButtonBorderBrush}" BorderThickness="1.5" CornerRadius="8" Padding="12,10" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="🎥" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Video (MP4)" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AppAccentBorderBrush}"/>
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AppAccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <RadioButton x:Name="SnaptubeModalAudioRadio"
                                     Grid.Column="2"
                                     GroupName="SnaptubeFormatGroup"
                                     Checked="SnaptubeModalFormat_Checked">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="bd" Background="{DynamicResource AppButtonBackgroundBrush}" BorderBrush="{DynamicResource AppButtonBorderBrush}" BorderThickness="1.5" CornerRadius="8" Padding="12,10" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="🎵" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Solo Audio (MP3)" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AppAccentBorderBrush}"/>
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AppAccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>
                    </Grid>

                    <!-- Selector de Calidad -->
                    <StackPanel x:Name="SnaptubeModalQualityPanel" Margin="0,0,0,16">
                        <TextBlock Text="Calidad de video deseada:" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="SnaptubeModalQualityComboBox"
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  Height="36"
                                  FontSize="12.5"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar"
                                Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="CloseSnaptubeDownloadModal_Click"/>
                        <Button Content="➕ Añadir a la Lista de Espera"
                                Padding="16,9"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="ConfirmSnaptubeDownload_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ==================== PANEL LATERAL / CAJÓN DE COLA Y LISTA DE ESPERA DE DESCARGAS ==================== -->
        <Border x:Name="DownloadQueueDrawerOverlay"
                Panel.ZIndex="60"
                Background="{DynamicResource AppOverlayBackgroundBrush}"
                Visibility="Collapsed">
            <Grid>
                <!-- Área transparente para cerrar al hacer clic afuera -->
                <Border Background="Transparent" MouseLeftButtonUp="CloseDownloadQueueDrawer_Click"/>

                <!-- Cajón lateral derecho -->
                <Border Width="470"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1.5,0,0,0"
                        Padding="22,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Cabecera de la Cola -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📥" FontSize="20" Margin="0,0,8,0"/>
                                <TextBlock Text="Cola y Lista de Espera"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                           FontSize="17"
                                           FontWeight="Bold"/>
                            </StackPanel>
                            <Button Content="✕"
                                    HorizontalAlignment="Right"
                                    Width="28"
                                    Height="28"
                                    Style="{StaticResource IconButtonStyle}"
                                    Click="CloseDownloadQueueDrawer_Click"/>
                        </Grid>

                        <!-- Lista de Espera y Descargas -->
                        <Grid Grid.Row="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock x:Name="DownloadQueueEmptyText"
                                               Text="No hay descargas en la lista de espera ni en curso."
                                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                                               FontSize="13"
                                               HorizontalAlignment="Center"
                                               Margin="0,40,0,0"
                                               Visibility="Collapsed"/>

                                    <ItemsControl x:Name="DownloadQueueItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,10"
                                                        Background="{DynamicResource AppSubtleBrush}"
                                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="14,12">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Fila 1: Badge MP4/MP3 + Título + Botón Quitar/Cancelar -->
                                                        <Grid Grid.Row="0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0"
                                                                    Background="{DynamicResource AppAccentBrush}"
                                                                    BorderBrush="{DynamicResource AppAccentBorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="5"
                                                                    Padding="6,2"
                                                                    Margin="0,0,8,0"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding FormatBadgeText}"
                                                                           Foreground="{DynamicResource AppAccentForegroundBrush}"
                                                                           FontSize="10.5"
                                                                           FontWeight="Bold"/>
                                                            </Border>

                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Title}"
                                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                                       FontSize="12.5"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center"/>

                                                            <!-- Botón cancelar o eliminar -->
                                                            <Button Grid.Column="2"
                                                                    Content="✕"
                                                                    Width="22"
                                                                    Height="22"
                                                                    FontSize="10"
                                                                    Margin="6,0,0,0"
                                                                    Tag="{Binding}"
                                                                    Style="{StaticResource IconButtonStyle}"
                                                                    Click="QueueItemRemoveBtn_Click"/>
                                                        </Grid>

                                                        <!-- Fila 2: Barra de Progreso (si está activa o descargando) -->
                                                        <ProgressBar Grid.Row="1"
                                                                     Height="6"
                                                                     Margin="0,8,0,4"
                                                                     Minimum="0"
                                                                     Maximum="100"
                                                                     Value="{Binding ProgressPercent}"
                                                                     Background="{DynamicResource AppBorderBrush}"
                                                                     Foreground="{DynamicResource AppAccentBorderBrush}"
                                                                     BorderThickness="0"
                                                                     Visibility="{Binding IsActive, Converter={StaticResource BoolToVisConverter}}"/>

                                                        <!-- Fila 3: Estado, Calidad y Botones abrir -->
                                                        <Grid Grid.Row="2" Margin="0,4,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding StatusText}"
                                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                                           FontSize="11"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <!-- Botón abrir archivo si está completado -->
                                                                <Button Content="▶ Abrir"
                                                                        Padding="8,3"
                                                                        FontSize="11"
                                                                        Margin="0,0,4,0"
                                                                        Tag="{Binding DestinationPath}"
                                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                                        Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisConverter}}"
                                                                        Click="QueueItemOpenFile_Click"/>

                                                                <Button Content="📂"
                                                                        Padding="7,3"
                                                                        FontSize="11"
                                                                        ToolTip="Ver en carpeta de descargas"
                                                                        Tag="{Binding DestinationPath}"
                                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                                        Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisConverter}}"
                                                                        Click="QueueItemOpenFolder_Click"/>

                                                                <!-- Botón reintentar si falló -->
                                                                <Button Content="🔄 Reintentar"
                                                                        Padding="8,3"
                                                                        FontSize="11"
                                                                        Tag="{Binding}"
                                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                                        Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisConverter}}"
                                                                        Click="QueueItemRetry_Click"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- Pie del Cajón con Botón Limpiar Completadas -->
                        <Border Grid.Row="2"
                                Margin="0,14,0,0"
                                Padding="0,12,0,0"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="0,1,0,0">
                            <Grid>
                                <Button Content="Limpiar completadas"
                                        Padding="12,6"
                                        FontSize="11.5"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="ClearCompletedQueueBtn_Click"/>
                                <Button Content="Abrir carpeta de descargas"
                                        HorizontalAlignment="Right"
                                        Padding="12,6"
                                        FontSize="11.5"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="OpenDownloadsFolderBtn_Click"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== PANTALLA DE ANIMACIÓN DE APERTURA (SPLASH INTRO) ==================== -->
        <Border x:Name="StartupSplashOverlay"
                Panel.ZIndex="100"
                Background="{DynamicResource AppSplashBackgroundBrush}">
            <StackPanel x:Name="SplashContentPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0"
                        RenderTransformOrigin="0.5,0.5">
                <StackPanel.RenderTransform>
                    <ScaleTransform x:Name="SplashScaleTransform" ScaleX="0.86" ScaleY="0.86"/>
                </StackPanel.RenderTransform>

                <Border Padding="30,24"
                        CornerRadius="20"
                        Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppAccentBorderBrush}"
                        BorderThickness="1.5"
                        HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#390007" BlurRadius="34" ShadowDepth="0" Opacity="0.65"/>
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/icon.png"
                               Width="88"
                               Height="88"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>
                        <Image Source="pack://application:,,,/Assets/logo.png"
                               Height="40"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="ChasClip — Descargador Universal Multimedia"
                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                           FontSize="14.5"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,18,0,12"/>

                <ProgressBar Width="220"
                             Height="4"
                             IsIndeterminate="True"
                             Background="{DynamicResource AppBorderBrush}"
                             Foreground="{DynamicResource AppAccentBorderBrush}"
                             BorderThickness="0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
