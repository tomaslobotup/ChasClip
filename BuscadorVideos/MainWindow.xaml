<Window x:Class="BuscadorVideos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:BuscadorVideos.Controls"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="BUSCAPP — Buscador Universal de Videos"
        Icon="pack://application:,,,/Assets/logo.png"
        Width="1380"
        Height="880"
        MinWidth="980"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#0B0E17"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">

    <Grid ClipToBounds="True">
        <!-- WebView2 fuera de pantalla (-3000,-3000) con resolución 1280x800: nunca se superpone a la ventana -->
        <Border Width="1280"
                Height="800"
                Margin="-3000,-3000,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                IsHitTestVisible="False">
            <wv2:WebView2 x:Name="ScraperWebView" Width="1280" Height="800"/>
        </Border>

        <!-- ==================== LAYOUT PRINCIPAL ==================== -->
        <Grid x:Name="MainLayoutGrid"
              Panel.ZIndex="10"
              Background="#0B0E17"
              Opacity="0"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="MainLayoutTranslate" Y="14"/>
            </Grid.RenderTransform>

            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ==================== PANEL LATERAL COLAPSABLE ==================== -->
            <Border x:Name="SidebarBorder"
                    Grid.Column="0"
                    Background="#111522"
                    BorderBrush="#20263B"
                    BorderThickness="0,0,1,0"
                    ClipToBounds="True">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="SidebarTranslate" X="0"/>
                </Border.RenderTransform>

                <Grid Margin="15,13,15,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Cabecera: Logo oficial BUSCAPP + Botón ocultar panel -->
                    <Border Grid.Row="0"
                            Margin="0,0,0,11"
                            Padding="4,2,2,11"
                            BorderBrush="#1E2438"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Image Grid.Column="0"
                                   Source="pack://application:,,,/Assets/logo.png"
                                   MaxHeight="48"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Left"
                                   Margin="4,0,0,0"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                            <Button Grid.Column="1"
                                    Content="◀"
                                    Width="30"
                                    Height="30"
                                    FontSize="12"
                                    VerticalAlignment="Center"
                                    ToolTip="Ocultar panel lateral (Ctrl+B)"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="0"
                                    Click="ToggleSidebarButton_Click"/>
                        </Grid>
                    </Border>

                    <!-- Selector entre Mis Páginas y Páginas NSFW (solo video directo, sin Hentai/series) -->
                    <Grid Grid.Row="1" Margin="0,0,0,11">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.18*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="ShowCustomSitesButton"
                                Grid.Column="0"
                                Margin="0,0,4,0"
                                Content="▶ Mis Páginas"
                                FontSize="12"
                                Padding="8,7"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="ShowCustomSitesButton_Click"/>

                        <Button x:Name="ToggleNsfwPanelButton"
                                Grid.Column="1"
                                Margin="4,0,0,0"
                                Content="🔞 Páginas NSFW"
                                FontSize="12"
                                Padding="8,7"
                                ToolTip="Toca para ver portales NSFW directos (brilla); vuelve a tocar para desmarcar y apagar NSFW"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="ToggleNsfwPanelButton_Click"/>
                    </Grid>

                    <!-- Formulario Agregar Página -->
                    <StackPanel x:Name="CustomSiteFormPanel" Grid.Row="2" Margin="0,0,0,10">
                        <TextBlock Text="Nombre del buscador / página:"
                                   Foreground="#AEB7D1"
                                   FontSize="11.5"
                                   Margin="0,0,0,3"/>
                        <TextBox x:Name="NewSiteNameTextBox"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 FontSize="12.5"
                                 Padding="10,6"
                                 Margin="0,0,0,7"
                                 ToolTip="Ej: YouTube, Dailymotion, Vimeo..."
                                 KeyDown="NewSiteInput_KeyDown"/>

                        <TextBlock Text="Enlace (URL, dominio o plantilla {q}):"
                                   Foreground="#AEB7D1"
                                   FontSize="11.5"
                                   Margin="0,0,0,3"/>
                        <TextBox x:Name="NewSiteUrlTextBox"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 FontSize="12.5"
                                 Padding="10,6"
                                 Margin="0,0,0,8"
                                 ToolTip="Ej: https://www.youtube.com, dailymotion.com, https://sitio.com/search?q={q}"
                                 KeyDown="NewSiteInput_KeyDown"/>

                        <Button Content="＋ Agregar a mi lista"
                                Padding="12,7"
                                FontSize="12.5"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="AddSiteButton_Click"/>
                    </StackPanel>

                    <!-- Acciones rápidas de Mi Lista + Revertir lo borrado + Restaurar predeterminadas -->
                    <StackPanel x:Name="CustomSiteActionsPanel" Grid.Row="3" Margin="0,0,0,8">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Margin="0,0,3,0"
                                    Content="Marcar todas"
                                    FontSize="11.5"
                                    Padding="7,5"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="SelectAllSites_Click"/>
                            <Button Grid.Column="1"
                                    Margin="3,0,3,0"
                                    Content="Desmarcar"
                                    FontSize="11.5"
                                    Padding="7,5"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="DeselectAllSites_Click"/>
                            <Button Grid.Column="2"
                                    Margin="3,0,0,0"
                                    Content="↺ Base"
                                    FontSize="11.5"
                                    Padding="8,5"
                                    ToolTip="Restaurar buscadores de video predeterminados que falten en la lista"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="RestoreDefaultSites_Click"/>
                        </Grid>

                        <Button x:Name="UndoDeletedSiteButton"
                                Content="↶ Revertir borrado en mi lista"
                                FontSize="11.5"
                                Padding="8,5"
                                IsEnabled="False"
                                ToolTip="Restaura la última página eliminada de tu lista"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="UndoDeletedSiteButton_Click"/>
                    </StackPanel>

                    <!-- Lista de páginas guardadas -->
                    <ScrollViewer x:Name="CustomSitesScrollViewer"
                                  Grid.Row="4"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="SavedSitesItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6"
                                            Padding="9,7"
                                            CornerRadius="9"
                                            Background="#171C2D"
                                            BorderBrush="#252C44"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0"
                                                      Click="SiteCheckBox_Click"/>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="8" Height="8" Fill="{Binding AccentHex}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               Foreground="#F0F3FA"
                                                               FontSize="12.5"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Url}"
                                                           Foreground="#7A84A2"
                                                           FontSize="10.5"
                                                           Margin="14,1,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <Button Grid.Column="2"
                                                    Content="✎"
                                                    ToolTip="Editar nombre y enlace"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    Tag="{Binding}"
                                                    Click="EditSiteButton_Click"/>

                                            <Button Grid.Column="3"
                                                    Content="✕"
                                                    ToolTip="Eliminar de mi lista (puedes revertirlo arriba)"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    Tag="{Binding}"
                                                    Click="DeleteSiteButton_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Panel desplegable de Colecciones NSFW verificadas (solo portales directos, sin Hentai) -->
                    <Grid x:Name="NsfwPanelGrid" Grid.Row="4" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="NsfwCategoriesItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,7"
                                                CornerRadius="9"
                                                Background="#171B2B"
                                                BorderBrush="#272D45"
                                                BorderThickness="1">
                                            <StackPanel>
                                                <Grid Margin="10,7">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding IsCategoryChecked, Mode=TwoWay}"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,8,0"
                                                              ToolTip="Marcar o desmarcar todas las páginas de esta categoría"
                                                              Click="NsfwCategoryCheckBox_Click"/>

                                                    <ToggleButton Grid.Column="1"
                                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                                  Cursor="Hand"
                                                                  Background="Transparent"
                                                                  BorderThickness="0"
                                                                  HorizontalContentAlignment="Stretch">
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Grid Background="Transparent">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0"
                                                                               Text="{Binding HeaderSummary}"
                                                                               ToolTip="{Binding HeaderSummary}"
                                                                               Foreground="#EEF2FA"
                                                                               FontSize="12.5"
                                                                               FontWeight="SemiBold"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock x:Name="chevronTxt"
                                                                               Grid.Column="1"
                                                                               Text="▸"
                                                                               Foreground="#9AA4BF"
                                                                               FontSize="13"
                                                                               Margin="6,0,2,0"
                                                                               VerticalAlignment="Center"/>
                                                                </Grid>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter TargetName="chevronTxt" Property="Text" Value="▾"/>
                                                                        <Setter TargetName="chevronTxt" Property="Foreground" Value="#8E80FF"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="chevronTxt" Property="Foreground" Value="#FFFFFF"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                    </ToggleButton>
                                                </Grid>

                                                <Border BorderBrush="#23293E"
                                                        BorderThickness="0,1,0,0"
                                                        Background="#121522"
                                                        CornerRadius="0,0,8,8"
                                                        Padding="10,6,8,6">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <ItemsControl ItemsSource="{Binding Sites}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,3">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <CheckBox Grid.Column="0"
                                                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                              VerticalAlignment="Center"
                                                                              Margin="4,0,8,0"
                                                                              Click="NsfwSiteCheckBox_Click"/>

                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding DisplayName}"
                                                                                   Foreground="#E5E9F5"
                                                                                   FontSize="12"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Text="{Binding Domain}"
                                                                                   Foreground="#747E99"
                                                                                   FontSize="10.5"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Apartado de Donaciones (Cafecito) -->
                    <Border Grid.Row="5"
                            Margin="0,10,0,0"
                            Padding="11,9"
                            CornerRadius="10"
                            Background="#1B1718"
                            BorderBrush="#5C3B1E"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="☕ Regálame un cafecito para seguir mejorándolo"
                                       Foreground="#FDE68A"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,7"/>

                            <Button Grid.Row="1"
                                    Content="☕ Invitar un Cafecito (cafecito.app/atomichead)"
                                    FontSize="11.2"
                                    Padding="8,6"
                                    ToolTip="Abrir https://cafecito.app/atomichead en el navegador"
                                    Style="{StaticResource CafecitoButtonStyle}"
                                    Click="DonateCafecitoButton_Click"/>
                        </Grid>
                    </Border>

                    <!-- Estado de autoguardado -->
                    <Border Grid.Row="6"
                            Margin="0,7,0,0"
                            Padding="10,7"
                            CornerRadius="8"
                            Background="#0E111B"
                            BorderBrush="#1E2438"
                            BorderThickness="1">
                        <TextBlock x:Name="SaveStatusTextBlock"
                                   Text="✓ Lista guardada automáticamente"
                                   Foreground="#6EE7B7"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ==================== ÁREA PRINCIPAL: BUSCADOR CON HISTORIAL, CONTROLES, CUADRÍCULA 3x4 Y PAGINACIÓN ==================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Barra Superior de Búsqueda, Historial Desplegable, Revertir, Borrar y Bloqueador de Anuncios -->
                <Border Grid.Row="0"
                        Background="#111522"
                        BorderBrush="#20263B"
                        BorderThickness="0,0,0,1"
                        Padding="16,13">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Botón mostrar/ocultar panel lateral -->
                        <Button x:Name="TopToggleSidebarButton"
                                Grid.Column="0"
                                Margin="0,0,10,0"
                                Content="☰"
                                FontSize="15"
                                Padding="11,7"
                                ToolTip="Ocultar o mostrar el panel lateral de páginas (Ctrl+B)"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="ToggleSidebarButton_Click"/>

                        <!-- Caja de Búsqueda con Historial Desplegable Integrado -->
                        <Grid x:Name="SearchInputContainer" Grid.Column="1">
                            <TextBox x:Name="SearchQueryTextBox"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     FontSize="14"
                                     Padding="13,9,72,9"
                                     PreviewMouseLeftButtonUp="SearchQueryTextBox_PreviewMouseLeftButtonUp"
                                     KeyDown="SearchQueryTextBox_KeyDown"
                                     TextChanged="SearchQueryTextBox_TextChanged"/>

                            <TextBlock Text="Buscar videos en tus páginas activas o pegar enlace https://..."
                                       Foreground="#636D8A"
                                       FontSize="13.5"
                                       Margin="15,0,76,0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchQueryTextBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Botones internos dentro de la barra de búsqueda: Limpiar texto (✕) y Desplegar Historial (🕒) -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,6,0">
                                <Button x:Name="ClearQueryTextButton"
                                        Content="✕"
                                        Width="26"
                                        Height="26"
                                        FontSize="11.5"
                                        Visibility="Collapsed"
                                        ToolTip="Limpiar texto escrito"
                                        Style="{StaticResource IconButtonStyle}"
                                        Click="ClearQueryTextButton_Click"/>

                                <Button x:Name="ToggleHistoryDropdownButton"
                                        Content="🕒▾"
                                        Width="36"
                                        Height="26"
                                        FontSize="11.5"
                                        ToolTip="Desplegar historial de búsquedas"
                                        Style="{StaticResource IconButtonStyle}"
                                        Click="ToggleHistoryDropdownButton_Click"/>
                            </StackPanel>

                            <!-- Popup de Historial Desplegable Justo Debajo de la Búsqueda -->
                            <Popup x:Name="SearchHistoryPopup"
                                   PlacementTarget="{Binding ElementName=SearchInputContainer}"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Slide">
                                <Border Width="{Binding ActualWidth, ElementName=SearchInputContainer}"
                                        Margin="0,4,0,0"
                                        Background="#151A2B"
                                        BorderBrush="#323C5E"
                                        BorderThickness="1.5"
                                        CornerRadius="10"
                                        Padding="8">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="22" ShadowDepth="6" Color="#000000" Opacity="0.6"/>
                                    </Border.Effect>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="6,2,4,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="🕒 Historial de búsquedas recientes"
                                                       Foreground="#9AA5C4"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <Button x:Name="ClearAllHistoryButton"
                                                    Grid.Column="1"
                                                    Content="🗑️ Borrar todo"
                                                    FontSize="11"
                                                    Padding="8,3"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="ClearAllHistoryButton_Click"/>
                                        </Grid>

                                        <TextBlock x:Name="EmptyHistoryText"
                                                   Grid.Row="1"
                                                   Text="Aún no hay búsquedas guardadas en el historial."
                                                   Foreground="#6E7896"
                                                   FontSize="12"
                                                   Margin="8,8,8,10"
                                                   Visibility="Collapsed"/>

                                        <ScrollViewer Grid.Row="2"
                                                      MaxHeight="250"
                                                      VerticalScrollBarVisibility="Auto">
                                            <ItemsControl x:Name="SearchHistoryItemsControl">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,1"
                                                                CornerRadius="7"
                                                                Background="Transparent">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <Button Grid.Column="0"
                                                                        Tag="{Binding}"
                                                                        Cursor="Hand"
                                                                        HorizontalContentAlignment="Stretch"
                                                                        Click="HistoryItemButton_Click">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="hBd"
                                                                                    Background="Transparent"
                                                                                    CornerRadius="7"
                                                                                    Padding="8,6">
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock Grid.Column="0"
                                                                                               Text="{Binding Query}"
                                                                                               Foreground="#EEF2FC"
                                                                                               FontSize="13"
                                                                                               TextTrimming="CharacterEllipsis"
                                                                                               VerticalAlignment="Center"/>
                                                                                    <TextBlock Grid.Column="1"
                                                                                               Text="{Binding MetaText}"
                                                                                               Foreground="#7C87A6"
                                                                                               FontSize="11"
                                                                                               Margin="10,0,4,0"
                                                                                               VerticalAlignment="Center"/>
                                                                                </Grid>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="hBd" Property="Background" Value="#232B45"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>

                                                                <Button Grid.Column="1"
                                                                        Content="✕"
                                                                        Margin="2,0,2,0"
                                                                        ToolTip="Eliminar esta búsqueda del historial"
                                                                        Tag="{Binding}"
                                                                        Style="{StaticResource IconButtonStyle}"
                                                                        Click="DeleteSingleHistoryItemButton_Click"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- Botón Buscar -->
                        <Button x:Name="SearchButton"
                                Grid.Column="2"
                                Margin="9,0,0,0"
                                Content="🔍 Buscar"
                                Padding="17,9"
                                FontSize="13"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="SearchButton_Click"/>

                        <!-- Botón Cancelar Búsqueda en Curso -->
                        <Button x:Name="CancelSearchButton"
                                Grid.Column="3"
                                Margin="7,0,0,0"
                                Content="Cancelar"
                                Visibility="Collapsed"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="CancelSearchButton_Click"/>

                        <!-- Botón Revertir a la Búsqueda Anterior -->
                        <Button x:Name="RevertSearchButton"
                                Grid.Column="4"
                                Margin="7,0,0,0"
                                Content="↩ Revertir"
                                Padding="11,8"
                                IsEnabled="False"
                                ToolTip="Volver a los resultados de la búsqueda anterior"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="RevertSearchButton_Click"/>

                        <!-- Botón Borrar Búsqueda Actual / Anterior -->
                        <Button x:Name="ClearSearchSessionButton"
                                Grid.Column="5"
                                Margin="6,0,0,0"
                                Content="🧹 Borrar"
                                Padding="11,8"
                                IsEnabled="False"
                                ToolTip="Borrar los resultados de la búsqueda actual y anterior"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="ClearSearchSessionButton_Click"/>

                        <!-- Botón Bloqueador de Anuncios ON/OFF con Advertencia -->
                        <Button x:Name="ToggleAdBlockButton"
                                Grid.Column="6"
                                Margin="8,0,0,0"
                                Content="🛡️ AdBlock: ON"
                                ToolTip="Bloqueador de anuncios y popups activo (evita errores de carga)"
                                Style="{StaticResource AdBlockOnButtonStyle}"
                                Click="ToggleAdBlockButton_Click"/>

                        <!-- Acceso rápido a Cafecito (visible incluso con panel lateral oculto) -->
                        <Button Grid.Column="7"
                                Margin="7,0,0,0"
                                Content="☕"
                                Padding="10,7"
                                ToolTip="Regálame un cafecito para seguir mejorándolo (cafecito.app/atomichead)"
                                Style="{StaticResource CafecitoButtonStyle}"
                                Click="DonateCafecitoButton_Click"/>
                    </Grid>
                </Border>

                <!-- Cartel de Aviso cuando alguna página consultada no es compatible o falló -->
                <Border x:Name="SearchWarningBanner"
                        Grid.Row="1"
                        Background="#281822"
                        BorderBrush="#881337"
                        BorderThickness="0,0,0,1"
                        Padding="20,8"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SearchWarningBannerText"
                                   Grid.Column="0"
                                   Foreground="#FECDD3"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="1"
                                Content="✕"
                                Width="24"
                                Height="24"
                                Margin="8,0,0,0"
                                Style="{StaticResource IconButtonStyle}"
                                Click="DismissSearchWarningBanner_Click"/>
                    </Grid>
                </Border>

                <!-- Barra de Filtros por Página -->
                <Border x:Name="FilterBarBorder"
                        Grid.Row="2"
                        Background="#0F121D"
                        BorderBrush="#1C2236"
                        BorderThickness="0,0,0,1"
                        Padding="20,9"
                        Visibility="Collapsed">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="FilterChipsItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,8,0"
                                            Tag="{Binding SiteId}"
                                            Cursor="Hand"
                                            Click="FilterChip_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="chipBd"
                                                        CornerRadius="15"
                                                        Padding="12,5"
                                                        Background="#181D2E"
                                                        BorderBrush="#2A324D"
                                                        BorderThickness="1">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="7" Height="7" Fill="{Binding AccentHex}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding Label}" Foreground="#EAEFF9" FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Count, StringFormat=' ({0})'}" Foreground="#9AA4BF" FontSize="12"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="chipBd" Property="Background" Value="#362F78"/>
                                                        <Setter TargetName="chipBd" Property="BorderBrush" Value="#7C6BFF"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="chipBd" Property="BorderBrush" Value="#6D5DFB"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Contenido Central: Cuadrícula 3x4 (12 videos por página) -->
                <Grid Grid.Row="3">
                    <ScrollViewer x:Name="GridScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="15,12,15,16">
                        <ItemsControl x:Name="VideosGridItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" VerticalAlignment="Top"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:VideoCardControl Video="{Binding}"
                                                               VideoSelected="VideoCardControl_VideoSelected"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Estado Inicial / Vacío -->
                    <StackPanel x:Name="EmptyStatePanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="480">
                        <TextBlock x:Name="EmptyStateIcon"
                                   Text="🎞️"
                                   FontSize="48"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,12"/>
                        <TextBlock x:Name="EmptyStateTitle"
                                   Text="Busca videos en tus buscadores favoritos"
                                   Foreground="#F0F3FA"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                        <TextBlock x:Name="EmptyStateSubtitle"
                                   Margin="0,8,0,0"
                                   Text="Ya tienes cargada una lista predeterminada de buscadores de video verificados. Escribe arriba lo que deseas ver y pasa el mouse sobre cada miniatura para previsualizar."
                                   Foreground="#8892AC"
                                   FontSize="13.5"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   LineHeight="20"/>
                    </StackPanel>

                    <!-- Cartel Central de Video / Página No Compatible cuando no se puede obtener video -->
                    <Border x:Name="IncompatibleSearchOverlay"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="490"
                            Background="#191624"
                            BorderBrush="#9F1239"
                            BorderThickness="1.5"
                            CornerRadius="14"
                            Padding="26,22">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Color="#000000" Opacity="0.55"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="⚠️"
                                       FontSize="40"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8"/>
                            <TextBlock x:Name="IncompatibleSearchTitle"
                                       Text="Este enlace o página no es compatible"
                                       Foreground="#FFE4E6"
                                       FontSize="17.5"
                                       FontWeight="Bold"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="IncompatibleSearchMessage"
                                       Margin="0,8,0,16"
                                       Text="No se pudo obtener ningún video compatible desde esta fuente (el sitio bloquea el acceso externo, requiere cuenta o utiliza protección DRM)."
                                       Foreground="#FDA4AF"
                                       FontSize="13"
                                       LineHeight="19"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="IncompatibleOpenBrowserButton"
                                        Content="🌐 Abrir en navegador"
                                        Margin="0,0,8,0"
                                        Visibility="Collapsed"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="IncompatibleOpenBrowserButton_Click"/>
                                <Button Content="Entendido"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="CloseIncompatibleSearchOverlay_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Overlay de Carga -->
                    <Border x:Name="LoadingOverlay"
                            Background="#CC0B0E17"
                            Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar Width="250"
                                         Height="5"
                                         IsIndeterminate="True"
                                         Background="#20263A"
                                         Foreground="#7C6BFF"
                                         BorderThickness="0"/>
                            <TextBlock x:Name="LoadingStatusText"
                                       Margin="0,14,0,0"
                                       Text="Conectando y recopilando videos..."
                                       Foreground="#EEF1FA"
                                       FontSize="14.5"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Barra Inferior de Paginación Dinámica (12 videos por página) -->
                <Border x:Name="PaginationBarBorder"
                        Grid.Row="4"
                        Background="#111522"
                        BorderBrush="#20263B"
                        BorderThickness="0,1,0,0"
                        Padding="22,11"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="PaginationSummaryText"
                                   Grid.Column="0"
                                   Foreground="#9BA4BE"
                                   FontSize="12.5"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button x:Name="PrevPageButton"
                                    Content="« Anterior"
                                    Margin="0,0,6,0"
                                    Padding="11,6"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="PrevPageButton_Click"/>

                            <ItemsControl x:Name="PageSelectorsItemsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="2,0"
                                                MinWidth="34"
                                                Height="32"
                                                Tag="{Binding}"
                                                Cursor="Hand"
                                                Click="PageSelectorButton_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="pgBd"
                                                            CornerRadius="7"
                                                            Padding="9,4"
                                                            Background="#1B2032"
                                                            BorderBrush="#2C334D"
                                                            BorderThickness="1">
                                                        <TextBlock x:Name="pgTxt"
                                                                   Text="{Binding Label}"
                                                                   Foreground="#DCE2F2"
                                                                   FontSize="12.5"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter TargetName="pgBd" Property="Background" Value="#6D5DFB"/>
                                                            <Setter TargetName="pgBd" Property="BorderBrush" Value="#8E80FF"/>
                                                            <Setter TargetName="pgTxt" Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsEllipsis}" Value="True">
                                                            <Setter TargetName="pgBd" Property="Background" Value="Transparent"/>
                                                            <Setter TargetName="pgBd" Property="BorderThickness" Value="0"/>
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsCurrent}" Value="False"/>
                                                                <Condition Binding="{Binding IsEllipsis}" Value="False"/>
                                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter TargetName="pgBd" Property="Background" Value="#2A314A"/>
                                                        </MultiDataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button x:Name="NextPageButton"
                                    Content="Siguiente »"
                                    Margin="6,0,0,0"
                                    Padding="11,6"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="NextPageButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ==================== MODAL EDITAR PÁGINA GUARDADA ==================== -->
        <Border x:Name="EditSiteModalOverlay"
                Panel.ZIndex="20"
                Background="#C406080E"
                Visibility="Collapsed">
            <Border Width="430"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="#161B2B"
                    BorderBrush="#313A58"
                    BorderThickness="1.5"
                    CornerRadius="14"
                    Padding="22">
                <StackPanel>
                    <TextBlock Text="Editar Página Guardada"
                               Foreground="#F4F6FC"
                               FontSize="17"
                               FontWeight="Bold"
                               Margin="0,0,0,16"/>

                    <TextBlock Text="Nombre:"
                               Foreground="#A7B0C9"
                               FontSize="12.5"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="EditSiteNameTextBox"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Margin="0,0,0,12"/>

                    <TextBlock Text="Enlace (URL o plantilla {q}):"
                               Foreground="#A7B0C9"
                               FontSize="12.5"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="EditSiteDomainTextBox"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Margin="0,0,0,18"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar"
                                Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="CancelEditSite_Click"/>
                        <Button Content="Guardar cambios"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="SaveEditSite_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ==================== MODAL ADVERTENCIA DESACTIVAR BLOQUEADOR DE ANUNCIOS ==================== -->
        <Border x:Name="AdBlockWarningModalOverlay"
                Panel.ZIndex="45"
                Background="#CC06080E"
                Visibility="Collapsed">
            <Border Width="470"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="#181523"
                    BorderBrush="#BE123C"
                    BorderThickness="1.5"
                    CornerRadius="14"
                    Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="26" ShadowDepth="6" Color="#000000" Opacity="0.65"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="⚠️" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="¿Desactivar el Bloqueador de Anuncios?"
                                   Foreground="#FFE4E6"
                                   FontSize="16.5"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Advertencia: El bloqueador integrado detiene ventanas emergentes (popups), redirecciones publicitarias, scripts invasivos y capas invisibles sobre los videos."
                               Foreground="#E2E8F0"
                               FontSize="13"
                               LineHeight="19"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>

                    <Border Background="#2D1520"
                            BorderBrush="#881337"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,9"
                            Margin="0,0,0,18">
                        <TextBlock Text="Si lo desactivas, las páginas externas pueden lanzar anuncios superpuestos o redirecciones que pueden causar errores de carga y reproducción."
                                   Foreground="#FDA4AF"
                                   FontSize="12.5"
                                   FontWeight="Medium"
                                   LineHeight="18"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="🛡️ Mantener activado (Recomendado)"
                                Margin="0,0,8,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="CancelDisableAdBlock_Click"/>
                        <Button Content="Desactivar bajo mi riesgo"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="ConfirmDisableAdBlock_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ==================== REPRODUCTOR DE VIDEO INTEGRADO CON REGULADOR DE CALIDAD Y DESCARGA ==================== -->
        <Border x:Name="PlayerModalOverlay"
                Panel.ZIndex="30"
                Background="#EB06070C"
                Visibility="Collapsed">
            <Grid Margin="28,20">
                <Border Background="#131724"
                        BorderBrush="#2C3450"
                        BorderThickness="1.5"
                        CornerRadius="14"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Barra superior del reproductor: Sitio, Título, Regulador de Calidad, Descargar, Enlace y Cerrar -->
                        <Border Grid.Row="0"
                                Background="#191E30"
                                BorderBrush="#29314C"
                                BorderThickness="0,0,0,1"
                                Padding="15,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border x:Name="PlayerSiteBadge"
                                        Grid.Column="0"
                                        CornerRadius="6"
                                        Padding="9,4"
                                        Margin="0,0,11,0"
                                        Background="#262E48"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="PlayerSiteText"
                                               Foreground="White"
                                               FontSize="12"
                                               FontWeight="Bold"/>
                                </Border>

                                <TextBlock x:Name="PlayerTitleText"
                                           Grid.Column="1"
                                           Foreground="#F4F6FC"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           FontFamily="Segoe UI, Segoe UI Emoji, Yu Gothic UI, Malgun Gothic, Microsoft YaHei UI"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,14,0"/>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Regulador de Calidad -->
                                    <TextBlock Text="Calidad:"
                                               Foreground="#A6B0CC"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>

                                    <ComboBox x:Name="PlayerQualityComboBox"
                                              Width="156"
                                              Margin="0,0,8,0"
                                              ToolTip="Regulador de calidad de reproducción y descarga"
                                              Style="{StaticResource ModernComboBoxStyle}"
                                              SelectionChanged="PlayerQualityComboBox_SelectionChanged"/>

                                    <!-- Botón Descargar en la calidad seleccionada -->
                                    <Button x:Name="DownloadVideoButton"
                                            Content="⬇ Descargar"
                                            Margin="0,0,8,0"
                                            Padding="13,7"
                                            ToolTip="Descargar este video en la calidad seleccionada en el regulador"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="DownloadVideoButton_Click"/>

                                    <Button x:Name="CopyVideoLinkButton"
                                            Content="📋 Copiar"
                                            Margin="0,0,7,0"
                                            ToolTip="Copiar enlace original del video"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="CopyVideoLinkButton_Click"/>

                                    <Button Content="🌐 Navegador"
                                            Margin="0,0,7,0"
                                            ToolTip="Abrir video en tu navegador predeterminado"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="OpenInBrowserButton_Click"/>

                                    <Button Content="✕ Cerrar"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="ClosePlayerButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Barra de progreso de descarga activa / notificación de calidad -->
                        <Border x:Name="PlayerDownloadBarBorder"
                                Grid.Row="1"
                                Background="#121829"
                                BorderBrush="#252E4A"
                                BorderThickness="0,0,0,1"
                                Padding="16,7"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="PlayerDownloadStatusText"
                                           Grid.Column="0"
                                           Text="Preparando descarga..."
                                           Foreground="#D8E0F8"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,14,0"/>

                                <ProgressBar x:Name="PlayerDownloadProgressBar"
                                             Grid.Column="1"
                                             Height="6"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="0"
                                             VerticalAlignment="Center"
                                             Background="#222A42"
                                             Foreground="#10B981"
                                             BorderThickness="0"/>

                                <Button x:Name="CancelDownloadButton"
                                        Grid.Column="2"
                                        Content="Cancelar descarga"
                                        FontSize="11.5"
                                        Padding="10,4"
                                        Margin="12,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="CancelDownloadButton_Click"/>
                            </Grid>
                        </Border>

                        <!-- Lienzo del Reproductor + Máscara de Carga + Cartel de No Compatible -->
                        <Grid Grid.Row="2" Background="#06070C" ClipToBounds="True">
                            <StackPanel x:Name="PlayerLoadingMask"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <ProgressBar Width="210"
                                             Height="4"
                                             IsIndeterminate="True"
                                             Background="#22283C"
                                             Foreground="#7C6BFF"
                                             BorderThickness="0"/>
                                <TextBlock Text="Preparando reproductor limpio..."
                                           Foreground="#D5DCF0"
                                           FontSize="13.5"
                                           Margin="0,12,0,0"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <wv2:WebView2 x:Name="PlayerWebView"/>

                            <!-- Cartel cuando no se puede obtener o reproducir el video -->
                            <Border x:Name="PlayerIncompatibleOverlay"
                                    Background="#F2090B13"
                                    Visibility="Collapsed">
                                <Border MaxWidth="470"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="#181524"
                                        BorderBrush="#BE123C"
                                        BorderThickness="1.5"
                                        CornerRadius="14"
                                        Padding="28,24">
                                    <StackPanel>
                                        <TextBlock Text="⚠️"
                                                   FontSize="42"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,10"/>
                                        <TextBlock Text="Este video no es compatible"
                                                   Foreground="#FFE4E6"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   TextAlignment="Center"/>
                                        <TextBlock x:Name="PlayerIncompatibleDetailText"
                                                   Margin="0,9,0,18"
                                                   Text="No se pudo obtener el video directamente en el reproductor integrado (el sitio bloquea la inserción externa, el archivo fue eliminado o el formato requiere reproducción en el navegador)."
                                                   Foreground="#FDA4AF"
                                                   FontSize="13"
                                                   LineHeight="19"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="🌐 Abrir en navegador externo"
                                                    Margin="0,0,10,0"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Click="OpenInBrowserButton_Click"/>
                                            <Button Content="✕ Cerrar"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="ClosePlayerButton_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== PANTALLA DE ANIMACIÓN DE APERTURA (SPLASH INTRO) ==================== -->
        <Border x:Name="StartupSplashOverlay"
                Panel.ZIndex="100"
                Background="#0B0E17">
            <StackPanel x:Name="SplashContentPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0"
                        RenderTransformOrigin="0.5,0.5">
                <StackPanel.RenderTransform>
                    <ScaleTransform x:Name="SplashScaleTransform" ScaleX="0.86" ScaleY="0.86"/>
                </StackPanel.RenderTransform>

                <Border Padding="26,20"
                        CornerRadius="20"
                        Background="#131829"
                        BorderBrush="#2A3354"
                        BorderThickness="1.5"
                        HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#6D5DFB" BlurRadius="34" ShadowDepth="0" Opacity="0.42"/>
                    </Border.Effect>
                    <Image Source="pack://application:,,,/Assets/logo.png"
                           MaxHeight="84"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <TextBlock Text="Buscador Multisitio Universal de Videos"
                           Foreground="#DCE2F5"
                           FontSize="14.5"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,18,0,12"/>

                <ProgressBar Width="220"
                             Height="4"
