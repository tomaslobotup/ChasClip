                                                        <Border CornerRadius="14" Background="#F43F5E" BorderThickness="2" BorderBrush="#FFFFFF"/>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Tag="#F59E0B" Width="28" Height="28" Margin="0,0,8,0" Cursor="Hand" Click="AccentPresetButton_Click">
