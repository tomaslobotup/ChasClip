                                                            <TextBlock Text="☀️" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                            <TextBlock Text="Blanco" Foreground="#F1F5F9" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="Luminoso" Foreground="#8492B4" FontSize="10.5" HorizontalAlignment="Center"/>
