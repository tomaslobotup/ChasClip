                               FontSize="13"
                               LineHeight="19"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>

                    <Border Background="#2D1520"
                            BorderBrush="#881337"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,9"
                            Margin="0,0,0,18">
