                                                    <ControlTemplate TargetType="Button">
                                                        <Border CornerRadius="14" Background="#F59E0B" BorderThickness="2" BorderBrush="#FFFFFF"/>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Tag="#3B82F6" Width="28" Height="28" Margin="0,0,8,0" Cursor="Hand" Click="AccentPresetButton_Click">
