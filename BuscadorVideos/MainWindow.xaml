                                                    <ControlTemplate TargetType="Button">
                                                        <Border CornerRadius="14" Background="#06B6D4" BorderThickness="2" BorderBrush="#FFFFFF"/>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Tag="#10B981" Width="28" Height="28" Margin="0,0,8,0" Cursor="Hand" Click="AccentPresetButton_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border CornerRadius="14" Background="#10B981" BorderThickness="2" BorderBrush="#FFFFFF"/>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Tag="#F43F5E" Width="28" Height="28" Margin="0,0,8,0" Cursor="Hand" Click="AccentPresetButton_Click">
