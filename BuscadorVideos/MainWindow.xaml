<Window x:Class="BuscadorVideos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:BuscadorVideos.Controls"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="BUSCAPP — Buscador Universal de Videos"
        Icon="pack://application:,,,/Assets/logo.ico"
        Width="1380"
        Height="880"
        MinWidth="980"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">

    <Grid ClipToBounds="True">
        <!-- WebView2 fuera de pantalla (-3000,-3000) con resolución 1280x800: nunca se superpone a la ventana -->
        <Border Width="1280"
                Height="800"
                Margin="-3000,-3000,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                IsHitTestVisible="False">
            <wv2:WebView2 x:Name="ScraperWebView" Width="1280" Height="800"/>
        </Border>

        <!-- ==================== LAYOUT PRINCIPAL ==================== -->
        <Grid x:Name="MainLayoutGrid"
              Panel.ZIndex="10"
              Background="{DynamicResource AppBackgroundBrush}"
              Opacity="0"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="MainLayoutTranslate" Y="14"/>
            </Grid.RenderTransform>

            <!-- ==================== 1) MENÚ INICIAL / PANTALLA DE BIENVENIDA ==================== -->
            <Grid x:Name="HomeMenuGrid" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Barra Superior del Menú Inicial -->
                <Border Grid.Row="0"
                        Background="#101422"
                        BorderBrush="#1D243A"
                        BorderThickness="0,0,0,1"
                        Padding="28,14">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/Assets/logo.png"
                                   MaxHeight="38"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Border Margin="14,0,0,0"
                                    Background="#1D243A"
                                    CornerRadius="6"
                                    Padding="8,3"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Centro de Medios"
                                           Foreground="#8B98BE"
                                           FontSize="11"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="⚙ Ajustes"
                                    Margin="0,0,8,0"
                                    Padding="12,7"
                                    ToolTip="Abrir apartado de Ajustes"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OpenSettingsModalButton_Click"/>
                            <Button Content="☕ Invitar un Cafecito"
                                    Padding="12,7"
                                    ToolTip="Regálame un cafecito para seguir mejorándolo (cafecito.app/atomichead)"
                                    Style="{StaticResource CafecitoButtonStyle}"
                                    Click="DonateCafecitoButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Contenido Central: Título y las 2 Tarjetas Principales -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="20,28">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="960">

                        <TextBlock Text="¿Qué deseas hacer hoy?"
                                   Foreground="#F1F4FD"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="Selecciona una opción para comenzar. Puedes regresar a este menú o alternar entre herramientas en cualquier momento."
                                   Foreground="#8892AE"
                                   FontSize="13.5"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,0,0,30"/>

                        <!-- Contenedor de las 2 Opciones en Paralelo -->
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Tarjeta 1: Buscador Universal de Videos -->
                            <Border Grid.Column="0"
                                    Background="{DynamicResource AppSurfaceBrush}"
                                    BorderBrush="{DynamicResource AppCardBorderBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="16"
                                    Padding="28,26"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="HomeMenu_OpenSearch_Click">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Color="#000000" Opacity="0.4"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                                        <Border Width="50" Height="50" CornerRadius="12" Background="#1D243B" BorderBrush="#3B466A" BorderThickness="1">
                                            <TextBlock Text="🔍" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="BUSCADOR" Foreground="#7C6BFF" FontSize="11" FontWeight="Bold"/>
                                            <TextBlock Text="Multisitio Simultáneo" Foreground="#E2E7F5" FontSize="15" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1"
                                               Text="Buscador Universal de Videos"
                                               Foreground="#FFFFFF"
                                               FontSize="18.5"
                                               FontWeight="Bold"
                                               Margin="0,0,0,10"/>

                                    <TextBlock Grid.Row="2"
                                               Text="Explora y encuentra videos al mismo tiempo en YouTube, Twitch, TikTok, Instagram y Dailymotion. Incluye vista previa interactiva al pasar el mouse, selector de cuadrícula de 3, 4 o 6 columnas y reproductor limpio sin publicidad."
                                               Foreground="#8F9BB9"
                                               FontSize="13"
                                               LineHeight="20"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,24"/>

                                    <Button Grid.Row="3"
                                            Content="🔍 Abrir Buscador Universal →"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Padding="16,11"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="HomeMenu_OpenSearch_Click"/>
                                </Grid>
                            </Border>

                            <!-- Tarjeta 2: Descargador Directo de Videos y Audio MP3 -->
                            <Border Grid.Column="2"
                                    Background="{DynamicResource AppSurfaceBrush}"
                                    BorderBrush="{DynamicResource AppCardBorderBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="16"
                                    Padding="28,26"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="HomeMenu_OpenDownloader_Click">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Color="#000000" Opacity="0.4"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                                        <Border Width="50" Height="50" CornerRadius="12" Background="#1B2637" BorderBrush="#25557E" BorderThickness="1">
                                            <TextBlock Text="📥" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="DESCARGAS" Foreground="#38BDF8" FontSize="11" FontWeight="Bold"/>
                                            <TextBlock Text="Video MP4 o Audio MP3" Foreground="#E2E7F5" FontSize="15" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1"
                                               Text="Descargador de Video y MP3"
                                               Foreground="#FFFFFF"
                                               FontSize="18.5"
                                               FontWeight="Bold"
                                               Margin="0,0,0,10"/>

                                    <TextBlock Grid.Row="2"
                                               Text="Pega el enlace directo de cualquier video de tus plataformas favoritas. Descarga el archivo de video en alta definición (1080p, 720p...) o extrae únicamente la pista de audio en formato MP3 de alta fidelidad."
                                               Foreground="#8F9BB9"
                                               FontSize="13"
                                               LineHeight="20"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,24"/>

                                    <Button Grid.Row="3"
                                            Content="📥 Abrir Descargador →"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Padding="16,11"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="HomeMenu_OpenDownloader_Click"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Acceso Rápido a Favoritos, Historial y Ajustes en el Menú Inicial -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <Button Content="⭐ Videos Favoritos"
                                    Margin="0,0,10,0"
                                    Padding="14,8"
                                    FontSize="12.5"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OpenFavoritesView_Click"/>
                            <Button Content="🕒 Historial de Videos"
                                    Margin="0,0,10,0"
                                    Padding="14,8"
                                    FontSize="12.5"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OpenHistoryView_Click"/>
                            <Button Content="⚙ Ajustes"
                                    Padding="14,8"
                                    FontSize="12.5"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OpenSettingsModalButton_Click"/>
                        </StackPanel>

                        <!-- Indicación de páginas soportadas en el Menú Inicial -->
                        <Border Background="#0E121E"
                                BorderBrush="#1F263C"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16,11"
                                HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Plataformas principales compatibles:"
                                           Foreground="#7885A8"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <Border Background="#2B1417" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="3,0">
                                    <TextBlock Text="YouTube" Foreground="#FCA5A5" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="#211535" BorderBrush="#A855F7" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="3,0">
                                    <TextBlock Text="Twitch" Foreground="#D8B4FE" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="#102525" BorderBrush="#00E5D4" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="3,0">
                                    <TextBlock Text="TikTok" Foreground="#5EEAD4" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="#2D1525" BorderBrush="#E1306C" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="3,0">
                                    <TextBlock Text="Instagram" Foreground="#F472B6" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="#122037" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="3,0">
                                    <TextBlock Text="Dailymotion" Foreground="#93C5FD" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Pie del Menú Inicial -->
                <Border Grid.Row="2"
                        Background="#0C0F18"
                        BorderBrush="#171C2D"
                        BorderThickness="0,1,0,0"
                        Padding="24,9">
                    <Grid>
                        <TextBlock Text="BUSCAPP • Buscador Universal y Descargador Multimedia"
                                   Foreground="#545F7C"
                                   FontSize="11.5"
                                   VerticalAlignment="Center"/>
                        <TextBlock HorizontalAlignment="Right"
                                   Text="v1.3.0"
                                   Foreground="#545F7C"
                                   FontSize="11.5"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================== 2) ÁREA DEL BUSCADOR UNIVERSAL ==================== -->
            <Grid x:Name="SearchAreaGrid" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="340"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ==================== PANEL LATERAL COLAPSABLE ==================== -->
                <Border x:Name="SidebarBorder"
                        Grid.Column="0"
                        Background="{DynamicResource AppSidebarBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="0,0,1,0"
                        ClipToBounds="True">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="SidebarTranslate" X="0"/>
                    </Border.RenderTransform>

                <Grid Margin="15,13,15,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Cabecera: Logo oficial BUSCAPP + Botón ocultar panel -->
                    <Border Grid.Row="0"
                            Margin="0,0,0,11"
                            Padding="4,2,2,11"
                            BorderBrush="#1E2438"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Image Grid.Column="0"
                                   Source="pack://application:,,,/Assets/logo.png"
                                   MaxHeight="48"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Left"
                                   Margin="4,0,0,0"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                            <Button Grid.Column="1"
                                    Content="◀"
                                    Width="30"
                                    Height="30"
                                    FontSize="12"
                                    VerticalAlignment="Center"
                                    ToolTip="Ocultar panel lateral (Ctrl+B)"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="0"
                                    Click="ToggleSidebarButton_Click"/>
                        </Grid>
                    </Border>

                    <!-- Accesos Rápidos (Favoritos e Historial) y Selector de Páginas -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,11">
                        <!-- Accesos Rápidos: Favoritos e Historial en la Barra Lateral -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="SidebarFavoritesButton"
                                    Grid.Column="0"
                                    Content="⭐ Favoritos"
                                    FontSize="12"
                                    Padding="6,7"
                                    ToolTip="Ver tus videos guardados como favoritos"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OpenFavoritesView_Click"/>

                            <Button x:Name="SidebarHistoryButton"
                                    Grid.Column="2"
                                    Content="🕒 Historial"
                                    FontSize="12"
                                    Padding="6,7"
                                    ToolTip="Ver historial de videos reproducidos recientemente"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OpenHistoryView_Click"/>
                        </Grid>

                        <!-- Selector entre Mis Páginas y Páginas NSFW (+18) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="ShowCustomSitesButton"
                                    Grid.Column="0"
                                    Margin="0,0,4,0"
                                    Content="▶ Mis Páginas"
                                    FontSize="12"
                                    Padding="8,7"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="ShowCustomSitesButton_Click"/>

                            <Button x:Name="ToggleNsfwPanelButton"
                                    Grid.Column="1"
                                    Margin="4,0,0,0"
                                    Content="🔞 Páginas NSFW"
                                    FontSize="12"
                                    Padding="8,7"
                                    Visibility="Collapsed"
                                    ToolTip="Toca para ver portales NSFW directos (brilla); vuelve a tocar para desmarcar y apagar NSFW"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="ToggleNsfwPanelButton_Click"/>
                        </Grid>
                    </StackPanel>

                    <!-- Formulario Agregar Página -->
                    <StackPanel x:Name="CustomSiteFormPanel" Grid.Row="2" Margin="0,0,0,10">
                        <TextBlock Text="Nombre del buscador / página:"
                                   Foreground="#AEB7D1"
                                   FontSize="11.5"
                                   Margin="0,0,0,3"/>
                        <TextBox x:Name="NewSiteNameTextBox"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 FontSize="12.5"
                                 Padding="10,6"
                                 Margin="0,0,0,7"
                                 ToolTip="Ej: YouTube, Dailymotion, Vimeo..."
                                 KeyDown="NewSiteInput_KeyDown"/>

                        <TextBlock Text="Enlace (URL, dominio o plantilla {q}):"
                                   Foreground="#AEB7D1"
                                   FontSize="11.5"
                                   Margin="0,0,0,3"/>
                        <TextBox x:Name="NewSiteUrlTextBox"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 FontSize="12.5"
                                 Padding="10,6"
                                 Margin="0,0,0,8"
                                 ToolTip="Ej: https://www.youtube.com, dailymotion.com, https://sitio.com/search?q={q}"
                                 KeyDown="NewSiteInput_KeyDown"/>

                        <Button Content="＋ Agregar a mi lista"
                                Padding="12,7"
                                FontSize="12.5"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="AddSiteButton_Click"/>
                    </StackPanel>

                    <!-- Acciones rápidas de Mi Lista + Revertir lo borrado + Restaurar predeterminadas -->
                    <StackPanel x:Name="CustomSiteActionsPanel" Grid.Row="3" Margin="0,0,0,8">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Margin="0,0,3,0"
                                    Content="Marcar todas"
                                    FontSize="11.5"
                                    Padding="7,5"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="SelectAllSites_Click"/>
                            <Button Grid.Column="1"
                                    Margin="3,0,3,0"
                                    Content="Desmarcar"
                                    FontSize="11.5"
                                    Padding="7,5"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="DeselectAllSites_Click"/>
                            <Button Grid.Column="2"
                                    Margin="3,0,0,0"
                                    Content="↺ Base"
                                    FontSize="11.5"
                                    Padding="8,5"
                                    ToolTip="Restaurar buscadores de video predeterminados que falten en la lista"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="RestoreDefaultSites_Click"/>
                        </Grid>

                        <Button x:Name="UndoDeletedSiteButton"
                                Content="↶ Revertir borrado en mi lista"
                                FontSize="11.5"
                                Padding="8,5"
                                IsEnabled="False"
                                ToolTip="Restaura la última página eliminada de tu lista"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="UndoDeletedSiteButton_Click"/>
                    </StackPanel>

                    <!-- Lista de páginas guardadas -->
                    <ScrollViewer x:Name="CustomSitesScrollViewer"
                                  Grid.Row="4"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="SavedSitesItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6"
                                            Padding="9,7"
                                            CornerRadius="9"
                                            Background="#171C2D"
                                            BorderBrush="#252C44"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0"
                                                      Click="SiteCheckBox_Click"/>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="8" Height="8" Fill="{Binding AccentHex}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               Foreground="#F0F3FA"
                                                               FontSize="12.5"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Url}"
                                                           Foreground="#7A84A2"
                                                           FontSize="10.5"
                                                           Margin="14,1,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <Button Grid.Column="2"
                                                    Content="✎"
                                                    ToolTip="Editar nombre y enlace"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    Tag="{Binding}"
                                                    Click="EditSiteButton_Click"/>

                                            <Button Grid.Column="3"
                                                    Content="✕"
                                                    ToolTip="Eliminar de mi lista (puedes revertirlo arriba)"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    Tag="{Binding}"
                                                    Click="DeleteSiteButton_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Panel desplegable de Colecciones NSFW verificadas (solo portales directos, sin Hentai) -->
                    <Grid x:Name="NsfwPanelGrid" Grid.Row="4" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="NsfwCategoriesItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,7"
                                                CornerRadius="9"
                                                Background="#171B2B"
                                                BorderBrush="#272D45"
                                                BorderThickness="1">
                                            <StackPanel>
                                                <Grid Margin="10,7">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding IsCategoryChecked, Mode=TwoWay}"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,8,0"
                                                              ToolTip="Marcar o desmarcar todas las páginas de esta categoría"
                                                              Click="NsfwCategoryCheckBox_Click"/>

                                                    <ToggleButton Grid.Column="1"
                                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                                  Cursor="Hand"
                                                                  Background="Transparent"
                                                                  BorderThickness="0"
                                                                  HorizontalContentAlignment="Stretch">
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Grid Background="Transparent">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0"
                                                                               Text="{Binding HeaderSummary}"
                                                                               ToolTip="{Binding HeaderSummary}"
                                                                               Foreground="#EEF2FA"
                                                                               FontSize="12.5"
                                                                               FontWeight="SemiBold"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock x:Name="chevronTxt"
                                                                               Grid.Column="1"
                                                                               Text="▸"
                                                                               Foreground="#9AA4BF"
                                                                               FontSize="13"
                                                                               Margin="6,0,2,0"
                                                                               VerticalAlignment="Center"/>
                                                                </Grid>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter TargetName="chevronTxt" Property="Text" Value="▾"/>
                                                                        <Setter TargetName="chevronTxt" Property="Foreground" Value="#8E80FF"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="chevronTxt" Property="Foreground" Value="#FFFFFF"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                    </ToggleButton>
                                                </Grid>

                                                <Border BorderBrush="#23293E"
                                                        BorderThickness="0,1,0,0"
                                                        Background="#121522"
                                                        CornerRadius="0,0,8,8"
                                                        Padding="10,6,8,6">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <ItemsControl ItemsSource="{Binding Sites}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,3">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <CheckBox Grid.Column="0"
                                                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                              VerticalAlignment="Center"
                                                                              Margin="4,0,8,0"
                                                                              Click="NsfwSiteCheckBox_Click"/>

                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding DisplayName}"
                                                                                   Foreground="#E5E9F5"
                                                                                   FontSize="12"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Text="{Binding Domain}"
                                                                                   Foreground="#747E99"
                                                                                   FontSize="10.5"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Estado de autoguardado -->
                    <Border Grid.Row="5"
                            Margin="0,7,0,0"
                            Padding="10,7"
                            CornerRadius="8"
                            Background="#0E111B"
                            BorderBrush="#1E2438"
                            BorderThickness="1">
                        <TextBlock x:Name="SaveStatusTextBlock"
                                   Text="✓ Lista guardada automáticamente"
                                   Foreground="#6EE7B7"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ==================== ÁREA PRINCIPAL: BUSCADOR CON HISTORIAL, CONTROLES, CUADRÍCULA 3x4 Y PAGINACIÓN ==================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Barra Superior de Búsqueda, Historial Desplegable, Revertir, Borrar y Bloqueador de Anuncios -->
                <Border Grid.Row="0"
                        Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,13">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Navegación: Ocultar panel lateral, Ir a Menú Inicial, Ir a Descargas -->
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0">
                            <Button x:Name="TopToggleSidebarButton"
                                    Content="☰"
                                    FontSize="15"
                                    Padding="10,7"
                                    ToolTip="Ocultar o mostrar el panel lateral de páginas (Ctrl+B)"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="ToggleSidebarButton_Click"/>

                            <Button Content="🏠 Menú"
                                    Margin="6,0,0,0"
                                    Padding="9,7"
                                    FontSize="12"
                                    ToolTip="Volver al menú inicial de opciones"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="NavToHomeMenu_Click"/>

                            <Button Content="📥 Descargas"
                                    Margin="6,0,0,0"
                                    Padding="9,7"
                                    FontSize="12"
                                    ToolTip="Abrir descargador de Video y MP3"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="NavToDownloaderArea_Click"/>


                        </StackPanel>

                        <!-- Caja de Búsqueda con Historial Desplegable Integrado -->
                        <Grid x:Name="SearchInputContainer" Grid.Column="1">
                            <TextBox x:Name="SearchQueryTextBox"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     FontSize="14"
                                     Padding="13,9,72,9"
                                     PreviewMouseLeftButtonUp="SearchQueryTextBox_PreviewMouseLeftButtonUp"
                                     KeyDown="SearchQueryTextBox_KeyDown"
                                     TextChanged="SearchQueryTextBox_TextChanged"/>

                            <TextBlock Text="Buscar videos en tus páginas activas o pegar enlace https://..."
                                       Foreground="#636D8A"
                                       FontSize="13.5"
                                       Margin="15,0,76,0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchQueryTextBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Botones internos dentro de la barra de búsqueda: Limpiar texto (✕) y Desplegar Historial (🕒) -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,6,0">
                                <Button x:Name="ClearQueryTextButton"
                                        Content="✕"
                                        Width="26"
                                        Height="26"
                                        FontSize="11.5"
                                        Visibility="Collapsed"
                                        ToolTip="Limpiar texto escrito"
                                        Style="{StaticResource IconButtonStyle}"
                                        Click="ClearQueryTextButton_Click"/>

                                <Button x:Name="ToggleHistoryDropdownButton"
                                        Content="🕒▾"
                                        Width="36"
                                        Height="26"
                                        FontSize="11.5"
                                        ToolTip="Desplegar historial de búsquedas"
                                        Style="{StaticResource IconButtonStyle}"
                                        Click="ToggleHistoryDropdownButton_Click"/>
                            </StackPanel>

                            <!-- Popup de Historial Desplegable Justo Debajo de la Búsqueda -->
                            <Popup x:Name="SearchHistoryPopup"
                                   PlacementTarget="{Binding ElementName=SearchInputContainer}"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Slide">
                                <Border Width="{Binding ActualWidth, ElementName=SearchInputContainer}"
                                        Margin="0,4,0,0"
                                        Background="#151A2B"
                                        BorderBrush="#323C5E"
                                        BorderThickness="1.5"
                                        CornerRadius="10"
                                        Padding="8">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="22" ShadowDepth="6" Color="#000000" Opacity="0.6"/>
                                    </Border.Effect>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="6,2,4,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="🕒 Historial de búsquedas recientes"
                                                       Foreground="#9AA5C4"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <Button x:Name="ClearAllHistoryButton"
                                                    Grid.Column="1"
                                                    Content="🗑️ Borrar todo"
                                                    FontSize="11"
                                                    Padding="8,3"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="ClearAllHistoryButton_Click"/>
                                        </Grid>

                                        <TextBlock x:Name="EmptyHistoryText"
                                                   Grid.Row="1"
                                                   Text="Aún no hay búsquedas guardadas en el historial."
                                                   Foreground="#6E7896"
                                                   FontSize="12"
                                                   Margin="8,8,8,10"
                                                   Visibility="Collapsed"/>

                                        <ScrollViewer Grid.Row="2"
                                                      MaxHeight="250"
                                                      VerticalScrollBarVisibility="Auto">
                                            <ItemsControl x:Name="SearchHistoryItemsControl">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,1"
                                                                CornerRadius="7"
                                                                Background="Transparent">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <Button Grid.Column="0"
                                                                        Tag="{Binding}"
                                                                        Cursor="Hand"
                                                                        HorizontalContentAlignment="Stretch"
                                                                        Click="HistoryItemButton_Click">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="hBd"
                                                                                    Background="Transparent"
                                                                                    CornerRadius="7"
                                                                                    Padding="8,6">
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock Grid.Column="0"
                                                                                               Text="{Binding Query}"
                                                                                               Foreground="#EEF2FC"
                                                                                               FontSize="13"
                                                                                               TextTrimming="CharacterEllipsis"
                                                                                               VerticalAlignment="Center"/>
                                                                                    <TextBlock Grid.Column="1"
                                                                                               Text="{Binding MetaText}"
                                                                                               Foreground="#7C87A6"
                                                                                               FontSize="11"
                                                                                               Margin="10,0,4,0"
                                                                                               VerticalAlignment="Center"/>
                                                                                </Grid>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="hBd" Property="Background" Value="#232B45"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>

                                                                <Button Grid.Column="1"
                                                                        Content="✕"
                                                                        Margin="2,0,2,0"
                                                                        ToolTip="Eliminar esta búsqueda del historial"
                                                                        Tag="{Binding}"
                                                                        Style="{StaticResource IconButtonStyle}"
                                                                        Click="DeleteSingleHistoryItemButton_Click"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- Botón Buscar -->
                        <Button x:Name="SearchButton"
                                Grid.Column="2"
                                Margin="9,0,0,0"
                                Content="🔍 Buscar"
                                Padding="17,9"
                                FontSize="13"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="SearchButton_Click"/>

                        <!-- Botón Cancelar Búsqueda en Curso -->
                        <Button x:Name="CancelSearchButton"
                                Grid.Column="3"
                                Margin="7,0,0,0"
                                Content="Cancelar"
                                Visibility="Collapsed"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="CancelSearchButton_Click"/>

                        <!-- Botón Revertir a la Búsqueda Anterior -->
                        <Button x:Name="RevertSearchButton"
                                Grid.Column="4"
                                Margin="7,0,0,0"
                                Content="↩ Revertir"
                                Padding="11,8"
                                IsEnabled="False"
                                ToolTip="Volver a los resultados de la búsqueda anterior"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="RevertSearchButton_Click"/>

                        <!-- Botón Borrar Búsqueda Actual / Anterior -->
                        <Button x:Name="ClearSearchSessionButton"
                                Grid.Column="5"
                                Margin="6,0,0,0"
                                Content="🧹 Borrar"
                                Padding="11,8"
                                IsEnabled="False"
                                ToolTip="Borrar los resultados de la búsqueda actual y anterior"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="ClearSearchSessionButton_Click"/>

                        <!-- Botón Bloqueador de Anuncios ON/OFF con Advertencia -->
                        <Button x:Name="ToggleAdBlockButton"
                                Grid.Column="6"
                                Margin="8,0,0,0"
                                Content="🛡️ AdBlock: ON"
                                ToolTip="Bloqueador de anuncios y popups activo (evita errores de carga)"
                                Style="{StaticResource AdBlockOnButtonStyle}"
                                Click="ToggleAdBlockButton_Click"/>

                        <!-- Acceso rápido a Cafecito (visible incluso con panel lateral oculto) -->
                        <Button Grid.Column="7"
                                Margin="7,0,0,0"
                                Content="☕"
                                Padding="10,7"
                                ToolTip="Regálame un cafecito para seguir mejorándolo (cafecito.app/atomichead)"
                                Style="{StaticResource CafecitoButtonStyle}"
                                Click="DonateCafecitoButton_Click"/>

                        <!-- Indicador sutil de Modo Incógnito (si está activo) -->
                        <Border x:Name="IncognitoIndicatorBadge"
                                Grid.Column="8"
                                Margin="7,0,0,0"
                                Background="#2A1B3D"
                                BorderBrush="#A78BFA"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8,5"
                                Visibility="Collapsed"
                                Cursor="Hand"
                                ToolTip="Modo Incógnito activo: no se guarda historial de búsquedas ni reproducción. Haz clic para desactivar."
                                MouseLeftButtonUp="ToggleIncognitoFromBadge_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🕶️ Incógnito" Foreground="#DDD6FE" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- Botón Ajustes Generales -->
                        <Button x:Name="OpenSettingsButton"
                                Grid.Column="9"
                                Margin="6,0,0,0"
                                Content="⚙ Ajustes"
                                Padding="11,7"
                                FontSize="12.5"
                                ToolTip="Abrir apartado de Ajustes (Temas, Privacidad, Descargas y Almacenamiento)"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OpenSettingsModalButton_Click"/>
                    </Grid>
                </Border>

                <!-- Cartel de Aviso cuando alguna página consultada no es compatible o falló -->
                <Border x:Name="SearchWarningBanner"
                        Grid.Row="1"
                        Background="#281822"
                        BorderBrush="#881337"
                        BorderThickness="0,0,0,1"
                        Padding="20,8"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SearchWarningBannerText"
                                   Grid.Column="0"
                                   Foreground="#FECDD3"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="1"
                                Content="✕"
                                Width="24"
                                Height="24"
                                Margin="8,0,0,0"
                                Style="{StaticResource IconButtonStyle}"
                                Click="DismissSearchWarningBanner_Click"/>
                    </Grid>
                </Border>

                <!-- Barra de Filtros por Página + Selector de Cuadrícula -->
                <Border x:Name="FilterBarBorder"
                        Grid.Row="2"
                        Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="20,7"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="FilterChipsItemsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,8,0"
                                                Tag="{Binding SiteId}"
                                                Cursor="Hand"
                                                Click="FilterChip_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="chipBd"
                                                            CornerRadius="15"
                                                            Padding="12,5"
                                                            Background="#181D2E"
                                                            BorderBrush="#2A324D"
                                                            BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Ellipse Width="7" Height="7" Fill="{Binding AccentHex}" Margin="0,0,6,0"/>
                                                            <TextBlock Text="{Binding Label}" Foreground="#EAEFF9" FontSize="12" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Count, StringFormat=' ({0})'}" Foreground="#9AA4BF" FontSize="12"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="chipBd" Property="Background" Value="#362F78"/>
                                                            <Setter TargetName="chipBd" Property="BorderBrush" Value="#7C6BFF"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="chipBd" Property="BorderBrush" Value="#6D5DFB"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Selector de Cuadrícula (3, 4, 6 columnas) -->
                        <Border Grid.Column="1"
                                Margin="14,0,0,0"
                                Background="#141824"
                                BorderBrush="#252D42"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="4,2"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⊞ Cuadrícula:"
                                           Foreground="#8E99B7"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="5,0,6,0"/>
                                <Button x:Name="GridCols3Btn"
                                        Content="3"
                                        Tag="3"
                                        ToolTip="Ver 3 videos por fila (12 por página)"
                                        Style="{StaticResource GridDensityButtonStyle}"
                                        Click="GridDensityButton_Click"/>
                                <Button x:Name="GridCols4Btn"
                                        Content="4"
                                        Tag="4"
                                        ToolTip="Ver 4 videos por fila (16 por página)"
                                        Style="{StaticResource GridDensityButtonStyle}"
                                        Click="GridDensityButton_Click"/>
                                <Button x:Name="GridCols6Btn"
                                        Content="6"
                                        Tag="6"
                                        ToolTip="Ver 6 videos por fila (24 por página)"
                                        Style="{StaticResource GridDensityButtonStyle}"
                                        Click="GridDensityButton_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Contenido Central: Cuadrícula dinámica de videos -->
                <Grid Grid.Row="3">
                    <ScrollViewer x:Name="GridScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="15,12,15,16">
                        <ItemsControl x:Name="VideosGridItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding SelectedGridColumns, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Top"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:VideoCardControl Video="{Binding}"
                                                               VideoSelected="VideoCardControl_VideoSelected"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Estado Inicial / Vacío -->
                    <StackPanel x:Name="EmptyStatePanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="480">
                        <TextBlock x:Name="EmptyStateIcon"
                                   Text="🎞️"
                                   FontSize="48"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,12"/>
                        <TextBlock x:Name="EmptyStateTitle"
                                   Text="Busca videos en tus buscadores favoritos"
                                   Foreground="#F0F3FA"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                        <TextBlock x:Name="EmptyStateSubtitle"
                                   Margin="0,8,0,0"
                                   Text="Ya tienes cargada una lista predeterminada de buscadores de video verificados. Escribe arriba lo que deseas ver y pasa el mouse sobre cada miniatura para previsualizar."
                                   Foreground="#8892AC"
                                   FontSize="13.5"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   LineHeight="20"/>
                    </StackPanel>

                    <!-- Cartel Central de Video / Página No Compatible cuando no se puede obtener video -->
                    <Border x:Name="IncompatibleSearchOverlay"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="490"
                            Background="#191624"
                            BorderBrush="#9F1239"
                            BorderThickness="1.5"
                            CornerRadius="14"
                            Padding="26,22">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Color="#000000" Opacity="0.55"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="⚠️"
                                       FontSize="40"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8"/>
                            <TextBlock x:Name="IncompatibleSearchTitle"
                                       Text="Este enlace o página no es compatible"
                                       Foreground="#FFE4E6"
                                       FontSize="17.5"
                                       FontWeight="Bold"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="IncompatibleSearchMessage"
                                       Margin="0,8,0,16"
                                       Text="No se pudo obtener ningún video compatible desde esta fuente (el sitio bloquea el acceso externo, requiere cuenta o utiliza protección DRM)."
                                       Foreground="#FDA4AF"
                                       FontSize="13"
                                       LineHeight="19"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="IncompatibleOpenBrowserButton"
                                        Content="🌐 Abrir en navegador"
                                        Margin="0,0,8,0"
                                        Visibility="Collapsed"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="IncompatibleOpenBrowserButton_Click"/>
                                <Button Content="Entendido"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="CloseIncompatibleSearchOverlay_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Overlay de Carga -->
                    <Border x:Name="LoadingOverlay"
                            Background="#CC0B0E17"
                            Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar Width="250"
                                         Height="5"
                                         IsIndeterminate="True"
                                         Background="#20263A"
                                         Foreground="#7C6BFF"
                                         BorderThickness="0"/>
                            <TextBlock x:Name="LoadingStatusText"
                                       Margin="0,14,0,0"
                                       Text="Conectando y recopilando videos..."
                                       Foreground="#EEF1FA"
                                       FontSize="14.5"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Barra Inferior de Paginación Dinámica -->
                <Border x:Name="PaginationBarBorder"
                        Grid.Row="4"
                        Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="22,11"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="PaginationSummaryText"
                                   Grid.Column="0"
                                   Foreground="#9BA4BE"
                                   FontSize="12.5"
                                   VerticalAlignment="Center"/>

                        <!-- Selector de Cuadrícula en Barra Inferior -->
                        <Border Grid.Column="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#141824"
                                BorderBrush="#252D42"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="4,2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⊞ Cuadrícula:"
                                           Foreground="#8E99B7"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="5,0,6,0"/>
                                <Button x:Name="BottomGridCols3Btn"
                                        Content="3"
                                        Tag="3"
                                        ToolTip="Ver 3 videos por fila (12 por página)"
                                        Style="{StaticResource GridDensityButtonStyle}"
                                        Click="GridDensityButton_Click"/>
                                <Button x:Name="BottomGridCols4Btn"
                                        Content="4"
                                        Tag="4"
                                        ToolTip="Ver 4 videos por fila (16 por página)"
                                        Style="{StaticResource GridDensityButtonStyle}"
                                        Click="GridDensityButton_Click"/>
                                <Button x:Name="BottomGridCols6Btn"
                                        Content="6"
                                        Tag="6"
                                        ToolTip="Ver 6 videos por fila (24 por página)"
                                        Style="{StaticResource GridDensityButtonStyle}"
                                        Click="GridDensityButton_Click"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button x:Name="PrevPageButton"
                                    Content="« Anterior"
                                    Margin="0,0,6,0"
                                    Padding="11,6"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="PrevPageButton_Click"/>

                            <ItemsControl x:Name="PageSelectorsItemsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="2,0"
                                                MinWidth="34"
                                                Height="32"
                                                Tag="{Binding}"
                                                Cursor="Hand"
                                                Click="PageSelectorButton_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="pgBd"
                                                            CornerRadius="7"
                                                            Padding="9,4"
                                                            Background="#1B2032"
                                                            BorderBrush="#2C334D"
                                                            BorderThickness="1">
                                                        <TextBlock x:Name="pgTxt"
                                                                   Text="{Binding Label}"
                                                                   Foreground="#DCE2F2"
                                                                   FontSize="12.5"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter TargetName="pgBd" Property="Background" Value="#6D5DFB"/>
                                                            <Setter TargetName="pgBd" Property="BorderBrush" Value="#8E80FF"/>
                                                            <Setter TargetName="pgTxt" Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsEllipsis}" Value="True">
                                                            <Setter TargetName="pgBd" Property="Background" Value="Transparent"/>
                                                            <Setter TargetName="pgBd" Property="BorderThickness" Value="0"/>
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsCurrent}" Value="False"/>
                                                                <Condition Binding="{Binding IsEllipsis}" Value="False"/>
                                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter TargetName="pgBd" Property="Background" Value="#2A314A"/>
                                                        </MultiDataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button x:Name="NextPageButton"
                                    Content="Siguiente »"
                                    Margin="6,0,0,0"
                                    Padding="11,6"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="NextPageButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <!-- Fin de SearchAreaGrid -->
        </Grid>

            <!-- ==================== 3) ÁREA DEDICADA DE DESCARGAS (VIDEO MP4 & AUDIO MP3) ==================== -->
            <Grid x:Name="DownloaderAreaGrid" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Barra Superior de Navegación del Descargador -->
                <Border Grid.Row="0"
                        Background="#101422"
                        BorderBrush="#1D243A"
                        BorderThickness="0,0,0,1"
                        Padding="22,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Botones de Navegación: Regresar al Menú Inicial y al Buscador -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="🏠 Menú Inicial"
                                    Padding="11,7"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="Volver a la pantalla de bienvenida y menú inicial"
                                    Click="NavToHomeMenu_Click"/>

                            <Button Content="🔍 Ir al Buscador"
                                    Padding="11,7"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="Ir a la cuadrícula de búsqueda de videos"
                                    Click="NavToSearchArea_Click"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="📥 Descargador Universal de Videos y MP3"
                                       Foreground="#EEF2FC"
                                       FontSize="15"
                                       FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="⚙ Ajustes"
                                    Margin="0,0,7,0"
                                    Padding="11,7"
                                    ToolTip="Abrir apartado de Ajustes"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OpenSettingsModalButton_Click"/>
                            <Button Content="☕"
                                    Padding="10,7"
                                    ToolTip="Regálame un cafecito (cafecito.app/atomichead)"
                                    Style="{StaticResource CafecitoButtonStyle}"
                                    Click="DonateCafecitoButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Contenido Principal del Descargador -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="24,20">
                    <StackPanel MaxWidth="820" HorizontalAlignment="Center">

                        <!-- Tarjeta de Páginas Soportadas Específicamente (sin mención de NSFW) -->
                        <Border Background="{DynamicResource AppSurfaceBrush}"
                                BorderBrush="{DynamicResource AppCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18,14"
                                Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="🌐 Plataformas soportadas específicamente para descarga:"
                                           Foreground="#AEB7D2"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10"/>

                                <WrapPanel>
                                    <Border Background="#1E1318" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="7" Padding="10,6" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🔴" FontSize="11" Margin="0,0,5,0"/>
                                            <TextBlock Text="YouTube" Foreground="#FCA5A5" FontSize="12" FontWeight="Bold"/>
                                            <TextBlock Text=" (Videos, Shorts)" Foreground="#9AA4BF" FontSize="11.5" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#1B142A" BorderBrush="#9146FF" BorderThickness="1" CornerRadius="7" Padding="10,6" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🟣" FontSize="11" Margin="0,0,5,0"/>
                                            <TextBlock Text="Twitch" Foreground="#D8B4FE" FontSize="12" FontWeight="Bold"/>
                                            <TextBlock Text=" (Clips, VODs)" Foreground="#9AA4BF" FontSize="11.5" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#0E2122" BorderBrush="#00E5D4" BorderThickness="1" CornerRadius="7" Padding="10,6" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="⚫" FontSize="11" Margin="0,0,5,0"/>
                                            <TextBlock Text="TikTok" Foreground="#5EEAD4" FontSize="12" FontWeight="Bold"/>
                                            <TextBlock Text=" (Videos y clips)" Foreground="#9AA4BF" FontSize="11.5" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#261222" BorderBrush="#E1306C" BorderThickness="1" CornerRadius="7" Padding="10,6" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🟠" FontSize="11" Margin="0,0,5,0"/>
                                            <TextBlock Text="Instagram" Foreground="#F472B6" FontSize="12" FontWeight="Bold"/>
                                            <TextBlock Text=" (Reels, Posts)" Foreground="#9AA4BF" FontSize="11.5" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#111B2C" BorderBrush="#2F80ED" BorderThickness="1" CornerRadius="7" Padding="10,6" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🔵" FontSize="11" Margin="0,0,5,0"/>
                                            <TextBlock Text="Dailymotion" Foreground="#93C5FD" FontSize="12" FontWeight="Bold"/>
                                            <TextBlock Text=" (Videos Full HD)" Foreground="#9AA4BF" FontSize="11.5" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Tarjeta de Ingreso de Enlace y Opciones -->
                        <Border Background="{DynamicResource AppSurfaceBrush}"
                                BorderBrush="{DynamicResource AppCardBorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="14"
                                Padding="24,20"
                                Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="Enlace del video a descargar:"
                                           Foreground="#E3E8F5"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,7"/>

                                <Grid Margin="0,0,0,14">
                                    <TextBox x:Name="DownloaderUrlTextBox"
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             FontSize="13.5"
                                             Padding="12,10,95,10"
                                             KeyDown="DownloaderUrlTextBox_KeyDown"
                                             TextChanged="DownloaderUrlTextBox_TextChanged"/>

                                    <TextBlock Text="Pega aquí el enlace https://... del video"
                                               Foreground="#636D8A"
                                               FontSize="13"
                                               Margin="14,0,100,0"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=DownloaderUrlTextBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Botones pegar y limpiar -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Button x:Name="DownloaderClearUrlBtn"
                                                Content="✕"
                                                Width="26"
                                                Height="26"
                                                FontSize="11"
                                                Visibility="Collapsed"
                                                ToolTip="Limpiar enlace"
                                                Style="{StaticResource IconButtonStyle}"
                                                Click="DownloaderClearUrlBtn_Click"/>

                                        <Button Content="📋 Pegar"
                                                Padding="8,4"
                                                FontSize="11.5"
                                                ToolTip="Pegar enlace copiado en el portapapeles"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="DownloaderPasteUrlBtn_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Detección de Plataforma según la URL escrita -->
                                <Border x:Name="DownloaderDetectedPlatformBorder"
                                        Background="#181F33"
                                        BorderBrush="#2C3756"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="10,6"
                                        Margin="0,0,0,14"
                                        Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="✓ Plataforma detectada: " Foreground="#8B97BC" FontSize="12"/>
                                        <TextBlock x:Name="DownloaderDetectedPlatformText" Text="YouTube" Foreground="#A78BFA" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <!-- Detección de Playlist de YouTube -->
                                <Border x:Name="DownloaderPlaylistDetectedBorder"
                                        Background="#241B38"
                                        BorderBrush="#7C6BFF"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,8"
                                        Margin="0,0,0,14"
                                        Visibility="Collapsed">
                                    <CheckBox x:Name="DownloaderDownloadFullPlaylistCheckBox"
                                              IsChecked="True"
                                              VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📑 Descargar Lista de Reproducción Completa (Playlist)"
                                                       Foreground="#EDE9FE"
                                                       FontSize="12.5"
                                                       FontWeight="Bold"/>
                                            <TextBlock Text=" — Descargará todos los videos/canciones en una subcarpeta organizada"
                                                       Foreground="#A78BFA"
                                                       FontSize="12"
                                                       Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </CheckBox>
                                </Border>

                                <!-- Selección de Formato: Video (MP4) o Audio (MP3) -->
                                <TextBlock Text="Selecciona qué deseas descargar:"
                                           Foreground="#E3E8F5"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,9"/>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Opción Video MP4 -->
                                    <RadioButton x:Name="DownloaderFormatVideoRadio"
                                                 Grid.Column="0"
                                                 GroupName="DownloaderFormat"
                                                 IsChecked="True"
                                                 Checked="DownloaderFormatRadio_Checked">
                                        <RadioButton.Template>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Border x:Name="fmtBd"
                                                        Background="#181D2E"
                                                        BorderBrush="#2F3957"
                                                        BorderThickness="1.5"
                                                        CornerRadius="10"
                                                        Padding="16,13"
                                                        Cursor="Hand">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="🎥" FontSize="18" Margin="0,0,8,0"/>
                                                            <TextBlock Text="Video Completo (MP4)" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold"/>
                                                        </StackPanel>
                                                        <TextBlock Text="Descarga el video con audio en alta resolución" Foreground="#8B97BC" FontSize="11.5" Margin="26,4,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="fmtBd" Property="Background" Value="#25244E"/>
                                                        <Setter TargetName="fmtBd" Property="BorderBrush" Value="#7C6BFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="fmtBd" Property="BorderBrush" Value="#9487FF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </RadioButton.Template>
                                    </RadioButton>

                                    <!-- Opción Audio MP3 -->
                                    <RadioButton x:Name="DownloaderFormatAudioRadio"
                                                 Grid.Column="2"
                                                 GroupName="DownloaderFormat"
                                                 Checked="DownloaderFormatRadio_Checked">
                                        <RadioButton.Template>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Border x:Name="fmtBd"
                                                        Background="#181D2E"
                                                        BorderBrush="#2F3957"
                                                        BorderThickness="1.5"
                                                        CornerRadius="10"
                                                        Padding="16,13"
                                                        Cursor="Hand">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="🎵" FontSize="18" Margin="0,0,8,0"/>
                                                            <TextBlock Text="Solo Audio (MP3)" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold"/>
                                                        </StackPanel>
                                                        <TextBlock Text="Extrae la pista de sonido en MP3 de alta fidelidad" Foreground="#8B97BC" FontSize="11.5" Margin="26,4,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="fmtBd" Property="Background" Value="#172F3E"/>
                                                        <Setter TargetName="fmtBd" Property="BorderBrush" Value="#38BDF8"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="fmtBd" Property="BorderBrush" Value="#7DD3FC"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </RadioButton.Template>
                                    </RadioButton>
                                </Grid>

                                <!-- Opciones secundarias: Calidad de Video y Carpeta de Destino -->
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="1.4*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Selector de Calidad (solo activo si formato es Video) -->
                                    <StackPanel x:Name="DownloaderQualityPanel" Grid.Column="0">
                                        <TextBlock Text="Calidad de video:" Foreground="#AEB7D2" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                        <ComboBox x:Name="DownloaderQualityComboBox"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  Height="36"
                                                  FontSize="12.5"/>
                                    </StackPanel>

                                    <!-- Panel informativo para MP3 -->
                                    <StackPanel x:Name="DownloaderAudioInfoPanel" Grid.Column="0" Visibility="Collapsed">
                                        <TextBlock Text="Calidad de audio:" Foreground="#AEB7D2" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                        <Border Background="#141824" BorderBrush="#252E46" BorderThickness="1" CornerRadius="8" Height="36" Padding="10,0">
                                            <TextBlock Text="MP3 Máxima Calidad (V0 / 320 kbps)" Foreground="#38BDF8" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Carpeta de Descargas -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Carpeta de destino:" Foreground="#AEB7D2" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                        <Grid>
                                            <TextBox x:Name="DownloaderFolderTextBox"
                                                     Style="{StaticResource ModernTextBoxStyle}"
                                                     Height="36"
                                                     FontSize="12"
                                                     Padding="10,8,75,8"
                                                     IsReadOnly="True"/>
                                            <Button Content="📁 Cambiar"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,5,0"
                                                    Padding="8,5"
                                                    FontSize="11"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="DownloaderBrowseFolderBtn_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <!-- Botón Principal de Descarga -->
                                <Button x:Name="DownloaderStartButton"
                                        Content="⬇ Iniciar Descarga"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Padding="20,12"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="DownloaderStartButton_Click"/>

                                <!-- Barra y Estado de Progreso de Descarga en Vivo -->
                                <Border x:Name="DownloaderProgressBorder"
                                        Margin="0,16,0,0"
                                        Background="#101524"
                                        BorderBrush="#252F4A"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="16,13"
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock x:Name="DownloaderProgressStatusText"
                                                       Text="Conectando y analizando video..."
                                                       Foreground="#F0F4FD"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <Button x:Name="DownloaderCancelButton"
                                                    HorizontalAlignment="Right"
                                                    Content="Cancelar"
                                                    FontSize="11"
                                                    Padding="8,4"
                                                    Style="{StaticResource DangerButtonStyle}"
                                                    Click="DownloaderCancelButton_Click"/>
                                        </Grid>

                                        <ProgressBar x:Name="DownloaderProgressBar"
                                                     Height="8"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="0"
                                                     Background="#1D243A"
                                                     Foreground="#7C6BFF"
                                                     BorderThickness="0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Cartel de Resultado / Éxito -->
                                <Border x:Name="DownloaderSuccessBorder"
                                        Margin="0,14,0,0"
                                        Background="#0F2821"
                                        BorderBrush="#10B981"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="16,13"
                                        Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="✓ Descarga completada con éxito"
                                                       Foreground="#A7F3D0"
                                                       FontSize="13"
                                                       FontWeight="Bold"/>
                                            <TextBlock x:Name="DownloaderSuccessFileNameText"
                                                       Text="video.mp4"
                                                       Foreground="#E6FFFA"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="▶ Reproducir / Abrir"
                                                    Padding="10,6"
                                                    FontSize="11.5"
                                                    Margin="0,0,6,0"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Click="DownloaderOpenCompletedFileBtn_Click"/>

                                            <Button Content="📂 Abrir carpeta"
                                                    Padding="10,6"
                                                    FontSize="11.5"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="DownloaderOpenCompletedFolderBtn_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Cartel de Error -->
                                <Border x:Name="DownloaderErrorBorder"
                                        Margin="0,14,0,0"
                                        Background="#2B141B"
                                        BorderBrush="#EF4444"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="16,12"
                                        Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="DownloaderErrorText"
                                                   Grid.Column="0"
                                                   Foreground="#FECDD3"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                Content="✕"
                                                Width="22"
                                                Height="22"
                                                Margin="8,0,0,0"
                                                Style="{StaticResource IconButtonStyle}"
                                                Click="DownloaderDismissErrorBtn_Click"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Historial de Descargas Recientes de la Sesión -->
                        <Border x:Name="DownloaderRecentSectionBorder"
                                Background="#101422"
                                BorderBrush="#1F263C"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18,14"
                                Margin="0,0,0,20"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="📁 Descargas completadas en esta sesión:"
                                           Foreground="#8F9CBF"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10"/>

                                <ItemsControl x:Name="DownloaderRecentItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#141928"
                                                    BorderBrush="#252F47"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="12,8"
                                                    Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0"
                                                            Background="#1F2942"
                                                            CornerRadius="5"
                                                            Padding="6,2"
                                                            Margin="0,0,10,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FormatType}"
                                                                   Foreground="#A5B4FC"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FileName}"
                                                                   Foreground="#EEF2FC"
                                                                   FontSize="12"
